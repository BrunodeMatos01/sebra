---
import { nav } from "../data/nav";
import { site } from "../data/site";
---
<header class="hd" data-header>
  <div class="hd__inner container">
    <a class="hd__brand" href="/" aria-label="Sebra — início">
      <img src="/img/logo-sebra.png" alt="Sebra" width="32" height="32" />
      <span>Sebra</span>
    </a>

    <nav class="hd__nav" aria-label="Navegação principal">
      {nav.map((item) =>
        item.children ? (
          <div class="hd__group" data-dropdown>
            <button class="hd__link hd__link--btn" type="button" aria-expanded="false">
              {item.label}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="hd__menu" role="menu">
              <div class="hd__menu-grid">
                {item.children.map((c) => (
                  <a class="hd__menu-item" href={c.href} role="menuitem">
                    <span class="hd__menu-title">{c.label}</span>
                    {c.desc && <span class="hd__menu-desc">{c.desc}</span>}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a class="hd__link" href={item.href}>{item.label}</a>
        )
      )}
    </nav>

    <div class="hd__actions">
      <a class="btn btn--ghost hd__login" href={site.appUrl}>Área do cliente</a>
      <a class="btn btn--primary" href="/#contato">Agende uma demonstração</a>
    </div>

    <button class="hd__burger" type="button" aria-label="Abrir menu" aria-expanded="false" data-burger>
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Menu mobile -->
  <div class="hd__mobile" data-mobile hidden>
    {nav.map((item) =>
      item.children ? (
        <details class="hd__macc">
          <summary>{item.label}</summary>
          <div class="hd__macc-body">
            {item.children.map((c) => <a href={c.href}>{c.label}</a>)}
          </div>
        </details>
      ) : (
        <a class="hd__mlink" href={item.href}>{item.label}</a>
      )
    )}
    <div class="hd__mobile-cta">
      <a class="btn btn--ghost" href={site.appUrl}>Área do cliente</a>
      <a class="btn btn--primary" href="/#contato">Agende uma demonstração</a>
    </div>
  </div>
</header>

<style>
  .hd {
    position: sticky; top: 0; z-index: 60;
    background: rgba(255,255,255,.86);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--line-soft);
    transition: box-shadow .2s ease, border-color .2s ease;
  }
  .hd.is-scrolled { box-shadow: 0 1px 0 rgba(11,18,32,.06), 0 10px 30px rgba(11,18,32,.05); }
  .hd__inner { height: var(--nav-h); display: flex; align-items: center; gap: 28px; }

  .hd__brand { display: flex; align-items: center; gap: 9px; font-family: var(--font-display); font-weight: 800; font-size: 20px; color: var(--navy); letter-spacing: -.02em; }
  .hd__brand img { border-radius: 6px; }

  .hd__nav { display: flex; align-items: center; gap: 4px; margin-left: 8px; }
  .hd__link { display: inline-flex; align-items: center; gap: 5px; padding: 9px 14px; border-radius: var(--r-sm); font-size: 15px; font-weight: 500; color: var(--ink-soft); background: none; border: 0; cursor: pointer; font-family: var(--font); transition: color .15s ease, background .15s ease; }
  .hd__link:hover, .hd__group:hover .hd__link--btn { color: var(--brand); background: #f2f6ff; }
  .hd__link svg { transition: transform .2s ease; }
  .hd__group:hover .hd__link svg { transform: rotate(180deg); }

  .hd__actions { display: flex; align-items: center; gap: 10px; margin-left: auto; }

  /* Dropdown */
  .hd__group { position: relative; }
  .hd__menu {
    position: absolute; top: calc(100% + 10px); left: 50%; transform: translateX(-50%) translateY(6px);
    min-width: 460px; background: #fff; border: 1px solid var(--line);
    border-radius: var(--r-md); box-shadow: var(--shadow-lg); padding: 10px;
    opacity: 0; visibility: hidden; transition: opacity .16s ease, transform .16s ease;
  }
  .hd__group:hover .hd__menu, .hd__group:focus-within .hd__menu { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); }
  .hd__menu::before { content: ""; position: absolute; top: -10px; left: 0; right: 0; height: 10px; }
  .hd__menu-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; }
  .hd__menu-item { display: flex; flex-direction: column; gap: 3px; padding: 12px 14px; border-radius: var(--r-sm); transition: background .14s ease; }
  .hd__menu-item:hover { background: #f2f6ff; }
  .hd__menu-title { font-weight: 600; font-size: 14.5px; color: var(--ink); }
  .hd__menu-item:hover .hd__menu-title { color: var(--brand); }
  .hd__menu-desc { font-size: 12.5px; color: var(--muted); line-height: 1.45; }

  .hd__burger { display: none; flex-direction: column; gap: 5px; width: 42px; height: 42px; align-items: center; justify-content: center; background: none; border: 1px solid var(--line); border-radius: var(--r-sm); cursor: pointer; margin-left: auto; }
  .hd__burger span { width: 18px; height: 2px; background: var(--ink); border-radius: 2px; transition: transform .2s ease, opacity .2s ease; }
  .hd__burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hd__burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .hd__burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .hd__mobile { display: none; flex-direction: column; padding: 12px 24px 22px; border-top: 1px solid var(--line-soft); background: #fff; }
  .hd__mobile[hidden] { display: none; }
  .hd__mlink, .hd__macc > summary { display: block; padding: 13px 4px; font-weight: 600; font-size: 16px; color: var(--ink); border-bottom: 1px solid var(--line-soft); cursor: pointer; list-style: none; }
  .hd__macc > summary::-webkit-details-marker { display: none; }
  .hd__macc > summary::after { content: "+"; float: right; color: var(--muted); font-weight: 400; }
  .hd__macc[open] > summary::after { content: "–"; }
  .hd__macc-body { display: flex; flex-direction: column; padding: 4px 0 10px 14px; }
  .hd__macc-body a { padding: 9px 4px; color: var(--ink-soft); font-size: 15px; }
  .hd__mobile-cta { display: grid; gap: 10px; margin-top: 18px; }
  .hd__mobile-cta .btn { width: 100%; }

  @media (max-width: 1080px) {
    .hd__nav, .hd__actions { display: none; }
    .hd__burger { display: flex; }
    .hd__mobile.is-open { display: flex; }
  }
</style>

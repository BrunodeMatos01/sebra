---
import AppFrame from "./AppFrame.astro";
import Icon from "../Icon.astro";
const alertas = [
  { t: "Vigência termina em 58 dias", d: "Hora de negociar a prorrogação", tone: "amber", i: "clock" },
  { t: "Reajuste disponível em 21 dias", d: "IPCA · data-base 03/2026", tone: "blue", i: "chart" },
  { t: "Garantia contratual válida", d: "Seguro-garantia até 04/2027", tone: "green", i: "shield" },
];
const emp = [
  { n: "2026NE00412", v: "R$ 48.000,00", f: "R$ 48.000,00", r: "R$ 48.000,00", s: ["Pago", "green"] },
  { n: "2026NE00587", v: "R$ 36.500,00", f: "R$ 22.140,00", r: "R$ 11.070,00", s: ["Parcialmente pago", "amber"] },
  { n: "2026NE00733", v: "R$ 20.000,00", f: "R$ 0,00", r: "R$ 0,00", s: ["Empenhado", "blue"] },
];
---
<AppFrame title="Contrato 087/2026" subtitle="Secretaria Municipal de Educação · Pregão eletrônico 041/2026" group="financeiro" active="Contratos Públicos" h={760}
  actions={[{ label: "Comprar para o contrato", icon: "cart" }, { label: "Emitir nota", primary: true, icon: "receipt" }]}>
  <div class="kg">
    <div class="kc"><small>Valor do contrato</small><b>R$ 104,5 mil</b><em>vigência até 03/2027</em><Icon name="contract" size={18} class="c-blue" /></div>
    <div class="kc"><small>Faturado (notas)</small><b>R$ 70,1 mil</b><em>67% do contrato</em><Icon name="receipt" size={18} class="c-vio" /></div>
    <div class="kc kc--ok"><small>Recebido</small><b>R$ 59,1 mil</b><em>pelo extrato</em><Icon name="bank" size={18} class="c-ok" /></div>
    <div class="kc kc--warn"><small>Saldo de empenho</small><b>R$ 34,4 mil</b><em>a faturar</em><Icon name="landmark" size={18} class="c-warn" /></div>
  </div>
  <p class="st" style="margin-top:18px">Avisos do contrato <small>Lei 14.133: vigência, reajuste e garantia</small></p>
  <table class="tbl">
    <tbody>
      {alertas.map((x) => (
        <tr><td style="width:60%"><b>{x.t}</b><span class="sub">{x.d}</span></td><td style="text-align:right"><span class={`pill pill--${x.tone}`}>{x.tone === "green" ? "Em dia" : x.tone === "amber" ? "Atenção" : "Programado"}</span></td></tr>
      ))}
    </tbody>
  </table>
  <p class="st" style="margin-top:18px">Empenhos <small>faturado e recebido se atualizam sozinhos</small></p>
  <table class="tbl">
    <thead><tr><th style="width:22%">Empenho</th><th class="num" style="width:19%">Empenhado</th><th class="num" style="width:19%">Faturado</th><th class="num" style="width:19%">Recebido</th><th style="width:21%">Situação</th></tr></thead>
    <tbody>
      {emp.map((e) => (
        <tr><td><b>{e.n}</b></td><td class="num">{e.v}</td><td class="num">{e.f}</td><td class="num">{e.r}</td><td><span class={`pill pill--${e.s[1]}`}>{e.s[0]}</span></td></tr>
      ))}
    </tbody>
  </table>
</AppFrame>

---
import AppFrame from "./AppFrame.astro";
import Icon from "../Icon.astro";
const meses = [["Jun", 58, 41], ["Jul", 64, 44], ["Ago", 61, 47], ["Set", 72, 49], ["Out", 78, 52], ["Nov", 86, 55]] as const;
const prox = [
  { n: "Distribuidora Vale Sul", d: "Matéria-prima · NF 4.512", v: "R$ 12.480,00", q: "amanhã" },
  { n: "Impostos do mês", d: "Guia de impostos de novembro", v: "R$ 36.010,00", q: "05/12" },
  { n: "Aluguel do galpão", d: "Recorrente mensal", v: "R$ 7.900,00", q: "10/12" },
];
---
<AppFrame title="Financeiro" subtitle="Recebimentos, contas, fluxo de caixa e previsão" group="financeiro" active="Financeiro" h={740}
  actions={[{ label: "Lançar por foto/XML", icon: "upload" }, { label: "Novo lançamento", primary: true, icon: "wallet" }]}>
  <div class="kg">
    <div class="kc"><small>Receita prevista</small><b>R$ 412,8 mil</b><em>no mês</em><Icon name="chart" size={18} class="c-blue" /></div>
    <div class="kc kc--ok"><small>Receita recebida</small><b>R$ 286,1 mil</b><em>69% do previsto</em><Icon name="wallet" size={18} class="c-ok" /></div>
    <div class="kc"><small>Saldo projetado</small><b>R$ 157,3 mil</b><em>a receber menos a pagar</em><Icon name="target" size={18} class="c-vio" /></div>
    <div class="kc kc--ok"><small>Resultado do mês</small><b>R$ 48,9 mil</b><em>recebido menos pago</em><Icon name="star" size={18} class="c-ok" /></div>
  </div>
  <div class="row2">
    <div class="panel">
      <p class="st">Previsão de caixa mensal <small>em milhares de reais</small></p>
      <div class="chart">
        <div class="chart__y"><span>100</span><span>75</span><span>50</span><span>25</span><span>0</span></div>
        {meses.map(([m, e, s]) => <div class="chart__col"><span style={`height:${e}%`}></span><span class="alt" style={`height:${s}%`}></span><em>{m}</em></div>)}
      </div>
      <div class="legend"><span><i style="background:#3b82f6"></i>Entradas</span><span><i style="background:#ef4444"></i>Saídas</span></div>
    </div>
    <div class="panel">
      <p class="st">Próximas contas a pagar</p>
      {prox.map((p) => (
        <div class="rc" style="padding:11px 12px">
          <span class="rc__tx"><b>{p.n}</b><span>{p.d} · vence {p.q}</span></span>
          <span class="rc__val">{p.v}</span>
        </div>
      ))}
    </div>
  </div>
</AppFrame>

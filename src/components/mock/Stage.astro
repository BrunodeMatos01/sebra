---
// "Palco" no estilo das apresentações Sebra: tela flutuando em perspectiva,
// virada PARA DENTRO da página (máx. 14°), com reflexo no piso e brilho atrás.
// Slot "pop": um detalhe ampliado que salta na frente da tela (como o zoom
// automático do gerador de apresentações).
import "../../styles/mock.css";
export interface Props {
  face?: "left" | "right"; // para onde a tela "olha" (o lado do texto)
  tilt?: number;           // graus, limitado a 14
  popAt?: "left" | "right";
  class?: string;
}
const { face = "left", tilt = 10, popAt = "left", class: cls = "" } = Astro.props;
const deg = Math.min(Math.abs(tilt), 14) * (face === "left" ? 1 : -1);
const hasPop = Astro.slots.has("pop");
---
<div class={`stage stage--face-${face} ${cls}`} style={`--tilt:${deg}deg`}>
  <div class="stage__glow" aria-hidden="true"></div>
  <div class="stage__screen"><slot /></div>
  {hasPop && <div class={`stage__pop stage__pop--${popAt}`}><slot name="pop" /></div>}
  <div class="stage__floor" aria-hidden="true"></div>
</div>

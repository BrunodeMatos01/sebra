---
import LeadForm from "./LeadForm.astro";
import Brand from "./Brand.astro";
import { site, waLink, waMsg } from "../data/site";
export interface Props {
  eyebrow?: string; title?: string; lead?: string; origem?: string; plano?: string; uid?: string; waText?: string;
  bullets?: string[];
}
const {
  eyebrow = "Fale com a Sebra",
  title = "Fale com a Sebra",
  lead = "Preencha uma vez e abrimos o WhatsApp com a mensagem pronta, para montarmos a demonstração em cima do seu cenário real.",
  origem = "Formulário do site", plano = "", uid = "contato", waText = waMsg.geral,
  bullets = ["Demonstração com o seu cenário, não um vídeo genérico", "Conversa com quem entende de gestão, fiscal e financeiro", "Implantação conduzida pela nossa equipe"],
} = Astro.props;
---
<section class="section section--wash contact" id="contato">
  <div class="container contact__grid">
    <div class="reveal">
      
      <h2 class="contact__title">{title}</h2>
      <p class="contact__lead">Preencha uma vez e abrimos o WhatsApp com a mensagem pronta.</p>
      <div class="contact__direct">
        <a href={waLink(waText)} target="_blank" rel="noopener"><Brand name="whatsapp" size={26} class="ic-wa" /><span>Prefere ir direto? Chame no WhatsApp<small>{site.whatsappDisplay}</small></span></a>
        <a href={site.instagram} target="_blank" rel="noopener"><Brand name="instagram" size={24} class="ic-ig" /><span>Acompanhe a Sebra no Instagram<small>{site.instagramHandle}</small></span></a>
      </div>
    </div>
    <div class="contact__form reveal" data-delay="1"><LeadForm uid={uid} origem={origem} plano={plano} /></div>
  </div>
</section>

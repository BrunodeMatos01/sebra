---
const items = [
  { q: "A IA substitui minha equipe?", a: "Não — ela potencializa. Reduz demora, qualifica leads e atende quando a equipe não está disponível. Quando precisa de humano, a conversa é assumida com todo o histórico e contexto." },
  { q: "Consigo emitir nota fiscal pela Sebra?", a: "Sim. A plataforma emite NF-e, NFS-e e NFC-e por provider homologado, guarda o certificado A1 com segurança, controla certidões e gera o pacote para o contador." },
  { q: "A Sebra controla o financeiro de verdade?", a: "Sim. Contas a pagar e receber, DRE, fluxo de caixa, cobrança automática por PIX/boleto e conciliação bancária (OFX e Open Finance) — a venda alimenta o financeiro sozinha." },
  { q: "Serve para o meu ramo?", a: "A Sebra tem um núcleo e verticais que você ativa conforme o negócio: varejo, indústria, distribuidor, serviços, construção, salão, clínica e quem vende para o governo." },
  { q: "A plataforma é personalizada para minha empresa?", a: "Sim. Identidade visual, fluxos, campos, status, permissões por cargo e por pessoa, e o conhecimento específico do seu negócio para a IA." },
  { q: "Preciso ter equipe técnica?", a: "Não. A implantação é conduzida com você, e o teste grátis serve justamente para entender sua operação e mostrar onde a plataforma gera resultado." },
];
---
<div class="faq" data-faq>
  {items.map((item, i) => (
    <div class={`faq__item${i === 0 ? " is-open" : ""}`}>
      <button class="faq__q" type="button">
        <span>{item.q}</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
      <div class="faq__a"><p>{item.a}</p></div>
    </div>
  ))}
</div>

<style>
  .faq { display: flex; flex-direction: column; gap: 12px; max-width: 820px; margin-inline: auto; }
  .faq__item { border: 1px solid var(--line); border-radius: var(--r-md); background: #fff; overflow: hidden; transition: border-color .18s ease; }
  .faq__item.is-open { border-color: #cdd9f4; }
  .faq__q { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 22px; background: none; border: 0; cursor: pointer; text-align: left; font-family: var(--font-display); font-weight: 600; font-size: 16.5px; color: var(--ink); }
  .faq__q svg { color: var(--brand); flex-shrink: 0; transition: transform .2s ease; }
  .faq__item.is-open .faq__q svg { transform: rotate(45deg); }
  .faq__a { max-height: 0; overflow: hidden; transition: max-height .28s ease; }
  .faq__item.is-open .faq__a { max-height: 320px; }
  .faq__a p { padding: 0 22px 22px; color: var(--ink-soft); font-size: 15.5px; line-height: 1.65; }
</style>

---
import { nav } from "../data/nav";
import { site, waLink, waMsg } from "../data/site";
import Brand from "./Brand.astro";
const col = (label: string) => nav.find((n) => n.label === label)?.children ?? [];
const year = new Date().getFullYear();
---
<footer class="ft">
  <div class="container ft__cta">
    <div>
      <p class="ft__cta-k">Sua empresa inteira num sistema só.</p>
      <p class="ft__cta-s">Fale com um especialista da Sebra direto pelo WhatsApp.</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--wa btn--lg" href={waLink(waMsg.geral)} target="_blank" rel="noopener"><Brand name="whatsapp" size={20} /> Falar no WhatsApp</a>
      <a class="btn btn--ghost btn--on-navy btn--lg" href={site.instagram} target="_blank" rel="noopener"><Brand name="instagram" size={18} /> {site.instagramHandle}</a>
    </div>
  </div>

  <div class="container ft__grid">
    <div class="ft__brand-col">
      <a class="ft__brand" href="/" aria-label="Sebra, página inicial">
        <img src="/img/logo-tile-128.png" alt="" width="52" height="52" decoding="async" />
        <span>Sebra</span>
      </a>
      <p class="ft__desc">Sistema de gestão empresarial completo: financeiro, notas fiscais, orçamentos, estoque, compras, equipe e licitações num sistema só.</p>
      <ul class="ft__contacts">
        <li><a href={waLink(waMsg.geral)} target="_blank" rel="noopener"><Brand name="whatsapp" size={17} /> {site.whatsappDisplay}</a></li>
        <li><a href={site.instagram} target="_blank" rel="noopener"><Brand name="instagram" size={17} /> {site.instagramHandle}</a></li>
        <li><a href={`mailto:${site.email}`}><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg> {site.email}</a></li>
      </ul>
    </div>

    <nav class="ft__col" aria-label="Licitações">
      <h2>Licitações</h2>
      {col("Licitações").map((c) => <a href={c.href}>{c.label}</a>)}
    </nav>
    <nav class="ft__col" aria-label="ERP completo">
      <h2>ERP completo</h2>
      {col("ERP completo").map((c) => <a href={c.href}>{c.label}</a>)}
    </nav>
    <nav class="ft__col" aria-label="Empresa">
      <h2>Sebra</h2>
      <a href="/automacoes/">Automação de processos</a>
      <a href="/planos/">Planos</a>
      <a href="/empresa/">Quem somos</a>
      <a href="/integracoes/">Integrações</a>
      {col("Segmentos").slice(1, 4).map((c) => <a href={c.href}>{c.label}</a>)}
      <a href={site.appUrl}>Entrar no sistema</a>
    </nav>
  </div>

  <div class="ft__bar">
    <div class="container ft__bar-inner">
      <span>© {year} {site.legalName}{site.cnpj && ` · CNPJ ${site.cnpj}`} · {site.city}, Brasil</span>
      <span>Software brasileiro de gestão empresarial.</span>
    </div>
  </div>
</footer>

<style>
  .ft { background: var(--navy-950); color: var(--on-dark-soft); }
  .ft__cta { display: flex; align-items: center; justify-content: space-between; gap: 28px; flex-wrap: wrap; padding-block: 48px; border-bottom: 1px solid rgba(255,255,255,.08); }
  .ft__cta-k { font-family: var(--font-display); font-weight: 700; font-size: clamp(24px, 2.6vw, 32px); color: #fff; letter-spacing: -.02em; }
  .ft__cta-s { margin-top: 8px; color: var(--on-dark-soft); }
  .ft__grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 40px; padding-block: 56px 44px; }
  .ft__brand { display: inline-flex; align-items: center; gap: 12px; font-family: var(--font-display); font-weight: 800; font-size: 24px; color: #fff; }
  .ft__brand img { width: 52px; height: 52px; border-radius: 13px; }
  .ft__desc { margin-top: 16px; max-width: 330px; font-size: 14.5px; line-height: 1.65; color: var(--on-dark-mute); }
  .ft__contacts { list-style: none; padding: 0; margin: 20px 0 0; display: grid; gap: 10px; }
  .ft__contacts a { display: inline-flex; align-items: center; gap: 10px; font-size: 14.5px; color: var(--on-dark-soft); }
  .ft__contacts a:hover { color: #fff; }
  .ft__col h2 { color: #fff; font-family: var(--font); font-size: 12.5px; letter-spacing: .1em; text-transform: uppercase; margin-bottom: 14px; }
  .ft__col a { display: block; padding: 6px 0; font-size: 14.5px; color: var(--on-dark-mute); }
  .ft__col a:hover { color: #fff; }
  .ft__bar { border-top: 1px solid rgba(255,255,255,.08); }
  .ft__bar-inner { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding-block: 22px 96px; font-size: 13px; color: var(--on-dark-mute); }
  @media (max-width: 900px) { .ft__grid { grid-template-columns: 1fr 1fr; gap: 32px; } .ft__brand-col { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .ft__grid { grid-template-columns: 1fr; } }
</style>

---
import { nav } from "../data/nav";
import { site, waLink } from "../data/site";
const solucoes = nav.find((n) => n.label === "Soluções")?.children ?? [];
const segmentos = nav.find((n) => n.label === "Segmentos")?.children ?? [];
---
<footer class="ft">
  <div class="container ft__grid">
    <div class="ft__brand-col">
      <a class="ft__brand" href="/">
        <img src="/img/logo-sebra.png" alt="Sebra" width="34" height="34" />
        <span>Sebra</span>
      </a>
      <p class="ft__desc">A plataforma completa com IA para atender, vender e gerir a empresa inteira num lugar só.</p>
      <div class="ft__contacts">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={waLink(site.whatsappPrimary)} target="_blank" rel="noopener">WhatsApp comercial</a>
      </div>
    </div>

    <nav class="ft__col" aria-label="Soluções">
      <h4>Soluções</h4>
      {solucoes.map((c) => <a href={c.href}>{c.label}</a>)}
    </nav>

    <nav class="ft__col" aria-label="Segmentos">
      <h4>Segmentos</h4>
      {segmentos.map((c) => <a href={c.href}>{c.label}</a>)}
    </nav>

    <nav class="ft__col" aria-label="Empresa">
      <h4>Empresa</h4>
      <a href="/empresa/">Quem somos</a>
      <a href="/integracoes/">Integrações</a>
      <a href="/planos/">Planos</a>
      <a href="/#contato">Contato</a>
      <a href={site.appUrl}>Área do cliente</a>
    </nav>
  </div>

  <div class="ft__bar">
    <div class="container ft__bar-inner">
      <span>© {new Date().getFullYear()} Sebra. Todos os direitos reservados.</span>
      <a class="ft__ig" href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram da Sebra">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor"/></svg>
        Instagram
      </a>
    </div>
  </div>
</footer>

<style>
  .ft { background: var(--navy-950); color: #aab6d0; }
  .ft__grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 40px; padding-block: 64px 48px; }
  .ft__brand { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-display); font-weight: 800; font-size: 22px; color: #fff; }
  .ft__brand img { border-radius: 6px; }
  .ft__desc { margin-top: 16px; max-width: 320px; font-size: 14.5px; line-height: 1.6; color: #8ea0c4; }
  .ft__contacts { display: flex; flex-direction: column; gap: 8px; margin-top: 20px; }
  .ft__contacts a { font-size: 14px; color: #b9c6e4; }
  .ft__contacts a:hover { color: #fff; }
  .ft__col h4 { color: #fff; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 16px; }
  .ft__col a { display: block; padding: 6px 0; font-size: 14.5px; color: #8ea0c4; }
  .ft__col a:hover { color: #fff; }
  .ft__bar { border-top: 1px solid rgba(255,255,255,.08); }
  .ft__bar-inner { display: flex; align-items: center; justify-content: space-between; padding-block: 22px; font-size: 13px; color: #6f7fa3; }
  .ft__ig { display: inline-flex; align-items: center; gap: 8px; color: #8ea0c4; }
  .ft__ig:hover { color: #fff; }
  @media (max-width: 860px) {
    .ft__grid { grid-template-columns: 1fr 1fr; gap: 32px; }
    .ft__brand-col { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .ft__grid { grid-template-columns: 1fr; }
    .ft__bar-inner { flex-direction: column; gap: 12px; }
  }
</style>

---
// Aviso de cookies (LGPD) ligado ao Consent Mode v2 do Google.
// Até a pessoa aceitar, o Analytics roda sem cookies (modo negado) e
// Clarity / Meta Pixel nem são carregados. IDs em src/data/site.ts.
import { site } from "../data/site";
---
<div class="ck" data-cookie hidden role="region" aria-label="Aviso de cookies"
  data-clarity={site.clarityId || undefined}
  data-pixel={site.metaPixelId || undefined}>
  <p class="ck__tx">
    Usamos cookies de medição para entender como o site é usado e melhorar o atendimento.
    Nada de venda de dados. <a href="/privacidade/#cookies">Saiba mais</a>.
  </p>
  <div class="ck__bt">
    <button type="button" class="btn btn--ghost btn--sm" data-consent="denied">Recusar</button>
    <button type="button" class="btn btn--primary btn--sm" data-consent="granted">Aceitar</button>
  </div>
</div>

<script>
  type Fn = ((...a: unknown[]) => void) & { q?: unknown[][]; queue?: unknown[][]; callMethod?: (...a: unknown[]) => void; loaded?: boolean; version?: string; push?: unknown };
  declare global { interface Window { gtag?: (...a: unknown[]) => void; clarity?: Fn; fbq?: Fn; _fbq?: Fn } }

  const box = document.querySelector<HTMLElement>("[data-cookie]");
  const addScript = (src: string) => {
    const s = document.createElement("script");
    s.async = true; s.src = src;
    document.head.appendChild(s);
  };

  // Ferramentas que só podem rodar com consentimento.
  let loaded = false;
  const loadTrackers = () => {
    if (loaded || !box) return;
    loaded = true;
    const clarity = box.dataset.clarity;
    if (clarity) {
      const c: Fn = (...a) => { (c.q = c.q || []).push(a); };
      window.clarity = window.clarity || c;
      addScript(`https://www.clarity.ms/tag/${encodeURIComponent(clarity)}`);
      window.clarity("consent");
    }
    const pixel = box.dataset.pixel;
    if (pixel && !window.fbq) {
      const f: Fn = (...a) => { f.callMethod ? f.callMethod(...a) : f.queue!.push(a); };
      f.push = f; f.loaded = true; f.version = "2.0"; f.queue = [];
      window.fbq = f; window._fbq = f;
      addScript("https://connect.facebook.net/en_US/fbevents.js");
      window.fbq("init", pixel);
      window.fbq("track", "PageView");
    }
  };

  let saved: string | null = null;
  try { saved = localStorage.getItem("sebra_consent"); } catch { /* modo privado */ }
  if (saved === "granted") loadTrackers();
  if (box && !saved) box.hidden = false;

  box?.querySelectorAll<HTMLButtonElement>("[data-consent]").forEach((b) =>
    b.addEventListener("click", () => {
      const v = b.dataset.consent === "granted" ? "granted" : "denied";
      try { localStorage.setItem("sebra_consent", v); } catch { /* ignore */ }
      window.gtag?.("consent", "update", { analytics_storage: v, ad_storage: v, ad_user_data: v, ad_personalization: v });
      window.gtag?.("set", "ads_data_redaction", v !== "granted");
      if (v === "granted") loadTrackers();
      else if (loaded) location.reload(); // revogou: recarrega sem as ferramentas
      box.hidden = true;
    }),
  );
  // Link "Preferências de cookies" (rodapé / página de privacidade) reabre o aviso.
  document.addEventListener("click", (e) => {
    if (!(e.target as HTMLElement).closest("[data-cookie-open]") || !box) return;
    e.preventDefault();
    box.hidden = false;
    box.querySelector<HTMLButtonElement>("[data-consent]")?.focus();
  });
</script>

<style>
  .ck {
    position: fixed; left: 20px; bottom: 20px; z-index: 80; max-width: 440px;
    background: #fff; border: 1px solid var(--line); border-radius: var(--r-md);
    box-shadow: var(--shadow-lg); padding: 16px 18px; display: grid; gap: 12px;
    animation: ckIn .3s cubic-bezier(.16,1,.3,1);
  }
  .ck[hidden] { display: none; }
  .ck__tx { margin: 0; font-size: 14px; line-height: 1.55; color: var(--ink-soft); }
  .ck__tx a { color: var(--brand); text-decoration: underline; }
  .ck__bt { display: flex; gap: 8px; justify-content: flex-end; }
  @keyframes ckIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @media (max-width: 620px) { .ck { left: 12px; right: 84px; bottom: 12px; max-width: none; padding: 14px; } }
  @media (prefers-reduced-motion: reduce) { .ck { animation: none; } }
</style>

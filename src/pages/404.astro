---
import Base from "../layouts/Base.astro";
import Brand from "../components/Brand.astro";
import { waLink, waMsg } from "../data/site";
---
<Base title="Página não encontrada | Sebra" description="Esta página não existe, mas você pode voltar para o início ou falar com a Sebra no WhatsApp." noindex>
  <section class="section showcase" style="min-height:60vh;display:grid;place-items:center;text-align:center">
    <div class="container" style="max-width:640px">
      
      <h1 style="color:#fff;font-size:clamp(32px,5vw,52px)">Essa página não existe, mas a gente pode te ajudar.</h1>
      <p style="margin-top:16px;font-size:18px">O endereço pode ter mudado, então volte para o início ou chame a gente no WhatsApp.</p>
      <div class="btn-row" style="justify-content:center;margin-top:28px">
        <a class="btn btn--light btn--lg" href="/">Ir para o início</a>
        <a class="btn btn--wa btn--lg" href={waLink(waMsg.geral)} target="_blank" rel="noopener"><Brand name="whatsapp" size={20} /> Falar no WhatsApp</a>
      </div>
    </div>
  </section>
</Base>

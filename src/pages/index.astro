---
import Base from "../layouts/Base.astro";
import Faq from "../components/Faq.astro";
import ContactSection from "../components/ContactSection.astro";
import Icon from "../components/Icon.astro";
import Brand from "../components/Brand.astro";
import Stage from "../components/mock/Stage.astro";
import Mock from "../components/mock/Mock.astro";
import MockFinanceiro from "../components/mock/MockFinanceiro.astro";
import MockOrcamento from "../components/mock/MockOrcamento.astro";
import MockLicitacao from "../components/mock/MockLicitacao.astro";
import MockDre from "../components/mock/MockDre.astro";
import MockContrato from "../components/mock/MockContrato.astro";
import { faqHome } from "../data/faq";
import { solucoes, getSolucao } from "../data/solucoes";
import { segmentos } from "../data/segmentos";
import { waLink, waMsg } from "../data/site";

// Abas do explorador: os módulos mais fortes, nesta ordem.
const abas = ["financeiro", "orcamentos", "fiscal", "comercial", "estoque", "compras", "multi-empresa"].map((s) => getSolucao(s)!);
const pick = (s: (typeof solucoes)[number]) => {
  const itens = s.groups.flatMap((g) => g.items);
  const destaques = s.highlights.map((h) => h.title);
  return [...s.highlights, ...itens.filter((i) => !destaques.includes(i.title))].slice(0, 7);
};
const outros = solucoes.filter((s) => !abas.includes(s));
// Nome curto na aba (cabe tudo numa linha); o nome completo aparece no painel.
const curto: Record<string, string> = { comercial: "Clientes", estoque: "Estoque" };

const jornadaGov = [
  { i: "search", t: "Edital", d: "Busca no PNCP" }, { i: "shield", t: "Habilitação", d: "Certidões em dia" },
  { i: "gavel", t: "Disputa", d: "Prazos e lances" }, { i: "contract", t: "Contrato", d: "Saldo por item" },
  { i: "landmark", t: "Empenho", d: "Calculado sozinho" }, { i: "receipt", t: "Nota", d: "Com retenções" },
  { i: "bank", t: "Recebimento", d: "Baixa automática" }, { i: "chart", t: "Lucro", d: "Por licitação" },
];
const seguranca = [
  { i: "key", t: "Certificado A1 cifrado", d: "O arquivo e a senha do certificado ficam cifrados com AES-256." },
  { i: "lock", t: "Cada empresa no seu espaço", d: "Os dados de uma empresa nunca aparecem para outra." },
  { i: "eye", t: "Acesso por perfil e valor", d: "Cada pessoa vê o que precisa. Despesa alta pede aprovação." },
  { i: "history", t: "Tudo fica registrado", d: "Auditoria das ações sensíveis e verificação em duas etapas." },
];
const etapas = [
  { t: "Diagnóstico", d: "Entendemos sua operação e o que precisa ligar." },
  { t: "Coleta", d: "Reunimos cadastros, certificado e saldos." },
  { t: "Validação", d: "Conferimos os dados antes de importar." },
  { t: "Importação", d: "Trazemos clientes, produtos e contas." },
  { t: "Homologação", d: "Testamos com você o dia a dia." },
  { t: "Go-live", d: "Liberamos e seguimos acompanhando." },
];
---
<Base
  title="Sebra ERP com IA | Sistema de gestão empresarial completo"
  description="ERP completo: orçamento que vira nota, financeiro com lucro real do mês, NF-e, estoque, compras, multi-empresa e licitações. Fale com a Sebra no WhatsApp."
  faq={faqHome}
>
  <!-- 1. HERÓI -->
  <section class="hero showcase">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Sistema de gestão empresarial · ERP</p>
        <h1>Sua empresa inteira <span class="accent">num sistema só</span>.</h1>
        <p class="hero__lead">Orçamento que vira nota fiscal, financeiro que mostra o lucro real do mês, estoque com o preço certo, compras, clientes e equipe. E, para quem vende ao governo, o controle completo de licitações e contratos.</p>
        <div class="btn-row">
          <a class="btn btn--wa btn--lg" href={waLink(waMsg.geral)} target="_blank" rel="noopener"><Brand name="whatsapp" size={20} /> Falar com um especialista</a>
          <a class="btn btn--ghost btn--on-navy btn--lg" href="#modulos">Conhecer os módulos <Icon name="arrowDown" size={18} /></a>
        </div>
        <ul class="hero__proof">
          <li><Icon name="check" size={16} stroke={2.6} />NF-e, NFS-e e NFC-e</li>
          <li><Icon name="check" size={16} stroke={2.6} />Conciliação bancária automática</li>
          <li><Icon name="check" size={16} stroke={2.6} />Implantação conduzida</li>
        </ul>
      </div>
      <div class="hero__visual">
        <div class="cascade">
          <div class="cascade__item"><MockLicitacao /></div>
          <div class="cascade__item"><MockOrcamento /></div>
          <div class="cascade__item"><MockFinanceiro /></div>
        </div>
      </div>
    </div>
    <p class="demo-tag container">Telas da plataforma com dados de demonstração.</p>
  </section>

  <!-- 2. QUAL É O SEU RAMO -->
  <section class="ramos" id="segmentos" aria-labelledby="ramos-t">
    <div class="container">
      <div class="ramos__head">
        <h2 id="ramos-t">Qual é o seu ramo?</h2>
        <p>A Sebra atende empresas de todos os tamanhos e segmentos. Escolha o seu e veja o sistema do seu jeito.</p>
      </div>
      <div class="ramos__grid">
        {segmentos.map((s) => (
          <a class="ramo" href={`/segmentos/${s.slug}/`}>
            <div class="ramo__ic"><Icon name={s.icon} size={22} /></div>
            <div class="ramo__tx"><p class="ramo__t">{s.nav}</p><p class="ramo__d">{s.menuDesc}</p></div>
            <Icon name="arrow" size={17} class="ramo__go" />
          </a>
        ))}
        <a class="ramo ramo--gov" href="/licitacoes/">
          <div class="ramo__ic"><Icon name="landmark" size={22} /></div>
          <div class="ramo__tx"><p class="ramo__t">Fornecedores do governo</p><p class="ramo__d">Licitações, contratos e empenhos</p></div>
          <Icon name="arrow" size={17} class="ramo__go" />
        </a>
      </div>
    </div>
  </section>

  <!-- 3. EXPLORADOR DE MÓDULOS -->
  <section class="section section--tint" id="modulos">
    <div class="container">
      <div class="s-head s-head--center reveal">
        <p class="eyebrow">O sistema</p>
        <h2>Módulos completos. Um sistema só.</h2>
        <p>Cada módulo é completo sozinho e conversa com todos os outros: o orçamento vira nota, a nota vira conta a receber, o extrato dá a baixa e o resultado aparece no fim do mês.</p>
      </div>

      <div class="ex reveal" data-tabs>
        <div class="ex__tabs" role="tablist" aria-label="Módulos da Sebra">
          {abas.map((s, i) => (
            <button class="ex__tab" type="button" role="tab" id={`tab-${s.slug}`} aria-controls={`pan-${s.slug}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
              <Icon name={s.icon} size={17} />{curto[s.slug] ?? s.nav}
            </button>
          ))}
          <a class="ex__tab ex__tab--lic" href="/licitacoes/"><Icon name="gavel" size={17} />Licitações</a>
        </div>
        {abas.map((s, i) => (
          <div class="ex__panel" role="tabpanel" id={`pan-${s.slug}`} aria-labelledby={`tab-${s.slug}`} hidden={i !== 0}>
            <div class="ex__copy">
              <p class="ex__k">{s.eyebrow}</p>
              <h3 class="ex__t">{s.title}</h3>
              <p class="ex__lead">{s.lead}</p>
              <ul class="ex__list">
                {pick(s).map((f) => <li><Icon name="check" size={16} stroke={2.6} class="ex__ck" /><span class="ex__li"><strong>{f.title}.</strong> {f.desc}</span></li>)}
              </ul>
              <a class="btn btn--primary" href={`/solucoes/${s.slug}/`}>Ver todas as funções de {s.nav.toLowerCase()} <Icon name="arrow" size={18} /></a>
            </div>
            <div class="ex__visual"><Stage face="right" tilt={7} class="light"><Mock m={s.mock} /></Stage></div>
          </div>
        ))}
      </div>

      <div class="more">
        <p class="more__k">E ainda:</p>
        <div class="more__grid">
          {outros.map((s) => (
            <a class="more__item" href={`/solucoes/${s.slug}/`}>
              <div class="more__ic"><Icon name={s.icon} size={19} /></div>
              <div><p class="more__t">{s.nav}</p><p class="more__d">{s.menuDesc}</p></div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 4. LUCRO REAL -->
  <section class="section showcase">
    <div class="container split">
      <div class="split__copy reveal">
        <p class="eyebrow">Financeiro de verdade</p>
        <h2>Quanto a sua empresa lucrou este mês?</h2>
        <p class="split__lead">A maioria das empresas só descobre quando o contador fecha o balanço. Na Sebra o DRE se monta sozinho a partir das notas e dos lançamentos: você sabe quanto vendeu, quanto custou e quanto sobrou, no dia que quiser.</p>
        <ul class="check-list">
          <li><strong>DRE por competência</strong> e fluxo de caixa por período</li>
          <li><strong>Resultado das vendas</strong> calculado pelas notas autorizadas</li>
          <li><strong>Conciliação automática</strong>: o extrato dá baixa nas notas pagas</li>
          <li><strong>Boleto</strong> com baixa automática quando é pago</li>
          <li>Comissões, centro de custo e aprovação por valor</li>
        </ul>
        <a class="btn btn--light" href="/solucoes/financeiro/">Ver todas as funções do financeiro <Icon name="arrow" size={18} /></a>
      </div>
      <div class="split__visual reveal" data-delay="1"><Stage face="left" tilt={9}><MockDre /></Stage></div>
    </div>
  </section>

  <!-- 5. FATOS -->
  <section class="section facts">
    <div class="container">
      <div class="facts__grid">
        <div class="fact reveal"><div class="fact__ic"><Icon name="receipt" size={22} /></div><p class="fact__n">Nota fiscal completa</p><p class="fact__l">NF-e, NFS-e e NFC-e emitidas por emissor homologado</p></div>
        <div class="fact reveal" data-delay="1"><div class="fact__ic"><Icon name="zap" size={22} /></div><p class="fact__n">Financeiro no automático</p><p class="fact__l">O extrato do banco dá baixa nas notas pagas sozinho</p></div>
        <div class="fact reveal" data-delay="2"><div class="fact__ic"><Icon name="shield" size={22} /></div><p class="fact__n">Documentos protegidos</p><p class="fact__l">Notas e XMLs guardados com segurança e cópia de segurança</p></div>
        <div class="fact reveal" data-delay="3"><div class="fact__ic"><Icon name="key" size={22} /></div><p class="fact__n">Certificado cifrado</p><p class="fact__l">Seu certificado digital protegido com criptografia</p></div>
      </div>
    </div>
  </section>

  <!-- 6. LICITAÇÕES -->
  <section class="section showcase gov" id="licitacoes">
    <div class="container">
      <div class="s-head s-head--center reveal">
        <p class="eyebrow">Especialidade Sebra</p>
        <h2>Vende para o governo? Aqui a Sebra é especialista.</h2>
        <p>O módulo de licitações acompanha a disputa e continua depois da vitória: contrato com saldo por item, empenho calculado sozinho, nota com retenção, boleto, recebimento e o lucro de cada processo.</p>
      </div>
      <ol class="gov__steps reveal">
        {jornadaGov.map((j) => <li><div class="gov__ic"><Icon name={j.i} size={19} /></div><p class="gov__t">{j.t}</p><p class="gov__d">{j.d}</p></li>)}
      </ol>
      <div class="split gov__split">
        <div class="split__copy reveal">
          <ul class="check-list">
            <li><strong>Busca de editais no PNCP</strong>, a base oficial de todo órgão sob a Lei 14.133</li>
            <li><strong>Quadro Kanban ligado à licitação</strong>: moveu o cartão, mudou o status, e vice-versa</li>
            <li><strong>Certidões com aviso</strong> antes de vencer e checklist de habilitação</li>
            <li><strong>Saldo de ata por item</strong>: contratado, comprado, entregue e o que falta</li>
            <li><strong>Empenhos</strong> com faturado e recebido calculados pelas notas</li>
            <li><strong>AF em PDF vira nota</strong>, até 50 de uma vez (CINCATARINA)</li>
            <li><strong>Resultado por licitação</strong> com custo real das compras</li>
          </ul>
          <div class="btn-row">
            <a class="btn btn--light btn--lg" href="/licitacoes/">Conhecer o módulo de licitações</a>
            <a class="btn btn--wa btn--lg" href={waLink(waMsg.licitacao)} target="_blank" rel="noopener"><Brand name="whatsapp" size={20} /> Ver funcionando</a>
          </div>
        </div>
        <div class="split__visual reveal" data-delay="1"><Stage face="left" tilt={9}><MockContrato /></Stage></div>
      </div>
    </div>
  </section>

  <!-- 7. CONFIANÇA -->
  <section class="section">
    <div class="container">
      <div class="s-head s-head--center reveal">
        <p class="eyebrow">Responsabilidade</p>
        <h2>Você vai confiar à Sebra o coração da sua empresa. A gente leva isso a sério.</h2>
        <p>Certificado digital, notas, dados bancários e financeiros. Cuidamos de cada um como se fosse nosso.</p>
      </div>
      <div class="grid grid--4 trust">
        {seguranca.map((s, i) => (
          <article class="card reveal" data-delay={i}>
            <div class="card__icon"><Icon name={s.i} size={22} /></div>
            <h3>{s.t}</h3><p>{s.d}</p>
          </article>
        ))}
      </div>
      <p class="trust__more reveal"><a class="link-arrow" href="/seguranca/">Como protegemos seus dados <Icon name="arrow" size={16} /></a></p>

      <div class="steps reveal">
        <div class="steps__head">
          <h3>Como colocamos a Sebra para rodar na sua empresa</h3>
          <p>Implantação conduzida pela nossa equipe, em seis etapas. Você continua trabalhando enquanto isso.</p>
        </div>
        <ol class="steps__list">
          {etapas.map((e, i) => (
            <li><p class="steps__n">{String(i + 1).padStart(2, "0")}</p><p class="steps__t">{e.t}</p><p class="steps__d">{e.d}</p></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 8. FAQ -->
  <section class="section section--soft">
    <div class="container">
      <div class="s-head s-head--center reveal">
        <p class="eyebrow">Perguntas frequentes</p>
        <h2>O que perguntam antes de fechar com a Sebra</h2>
      </div>
      <div class="reveal" style="margin-top:44px"><Faq items={faqHome} /></div>
    </div>
  </section>

  <!-- 9. PLANOS + CONTATO -->
  <section class="cta-band">
    <div class="container cta-band__inner reveal">
      <div>
        <h2>Veja os planos e escolha o que combina com a sua empresa</h2>
        <p>Do essencial ao grupo com vários CNPJs, com o módulo de licitações para quem vende ao governo.</p>
      </div>
      <div class="btn-row">
        <a class="btn btn--light btn--lg" href="/planos/">Ver os planos</a>
        <a class="btn btn--wa btn--lg" href={waLink(waMsg.planos)} target="_blank" rel="noopener"><Brand name="whatsapp" size={20} /> Falar agora</a>
      </div>
    </div>
  </section>

  <ContactSection origem="Página inicial" uid="home" />
</Base>

<script>
  // Abas do explorador (teclado: setas esquerda/direita)
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('button[role="tab"]')];
    const select = (t: HTMLButtonElement, focus = false) => {
      tabs.forEach((x) => {
        const on = x === t;
        x.setAttribute("aria-selected", String(on));
        x.tabIndex = on ? 0 : -1;
        const pan = document.getElementById(x.getAttribute("aria-controls")!);
        if (pan) pan.hidden = !on;
      });
      if (focus) t.focus();
      window.dispatchEvent(new Event("resize"));
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(t));
      t.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") select(tabs[(i + 1) % tabs.length], true);
        if (e.key === "ArrowLeft") select(tabs[(i - 1 + tabs.length) % tabs.length], true);
      });
    });
  });
</script>

<style>
  /* HERÓI */
  .hero { padding-block: clamp(56px, 7vw, 92px) clamp(24px, 3vw, 36px); }
  .hero__grid { display: grid; grid-template-columns: .92fr 1.08fr; gap: clamp(28px, 4vw, 52px); align-items: center; }
  .hero h1 { font-size: clamp(38px, 5.2vw, 64px); color: #fff; letter-spacing: -.03em; line-height: 1.04; }
  .hero__lead { margin-top: 22px; font-size: clamp(16.5px, 1.35vw, 19px); color: var(--on-dark-soft); max-width: 560px; line-height: 1.62; }
  .hero .btn-row { margin-top: 30px; }
  .hero__proof { list-style: none; padding: 0; margin: 28px 0 0; display: flex; flex-wrap: wrap; gap: 10px 22px; }
  .hero__proof li { display: inline-flex; align-items: center; gap: 8px; font-size: 14.5px; color: var(--on-dark-soft); }
  .hero__proof :global(svg) { color: #4ade80; }
  .hero__visual { min-width: 0; }
  @media (max-width: 940px) { .hero__grid { grid-template-columns: 1fr; } }

  /* RAMOS */
  .ramos { background: #fff; padding-block: clamp(44px, 6vw, 72px); border-bottom: 1px solid var(--line-soft); }
  .ramos__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
  .ramos__head h2 { font-size: clamp(26px, 3vw, 36px); }
  .ramos__head p { color: var(--ink-soft); max-width: 520px; font-size: 16.5px; }
  .ramos__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 28px; }
  .ramo { display: flex; align-items: center; gap: 14px; padding: 16px 18px; border-radius: var(--r-md); border: 1px solid var(--line); background: #fff; transition: border-color .2s ease, transform .2s ease, box-shadow .2s ease; }
  .ramo:hover { border-color: var(--brand); transform: translateY(-2px); box-shadow: var(--shadow); }
  .ramo__ic { flex-shrink: 0; width: 46px; height: 46px; border-radius: 12px; display: grid; place-items: center; background: var(--grad-brand-soft); color: var(--brand); transition: background .2s ease, color .2s ease; }
  .ramo:hover .ramo__ic { background: var(--grad-brand); color: #fff; }
  .ramo__tx { flex: 1; min-width: 0; }
  .ramo__t { font-weight: 700; color: var(--ink); font-size: 15.5px; }
  .ramo__d { color: var(--muted); font-size: 13.5px; margin-top: 2px; line-height: 1.4; }
  .ramo :global(.ramo__go) { color: var(--muted); flex-shrink: 0; transition: transform .2s ease, color .2s ease; }
  .ramo:hover :global(.ramo__go) { color: var(--brand); transform: translateX(3px); }
  .ramo--gov { background: var(--navy-900); border-color: var(--navy-900); }
  .ramo--gov .ramo__t { color: #fff; }
  .ramo--gov .ramo__d { color: var(--on-dark-soft); }
  .ramo--gov .ramo__ic { background: rgba(110,160,255,.18); color: var(--brand-light); }
  .ramo--gov:hover .ramo__ic { background: var(--brand); color: #fff; }
  @media (max-width: 1020px) { .ramos__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .ramos__grid { grid-template-columns: 1fr; } }

  /* EXPLORADOR */
  .ex { margin-top: 44px; background: #fff; border: 1px solid var(--line); border-radius: var(--r-lg); box-shadow: var(--shadow); overflow: hidden; }
  .ex__tabs { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px; border-bottom: 1px solid var(--line-soft); background: #fafcff; }
  .ex__tab { display: inline-flex; align-items: center; gap: 7px; height: 42px; padding: 0 13px; border-radius: 11px; border: 0; background: none; font: inherit; font-weight: 600; font-size: 14.5px; color: var(--ink-soft); cursor: pointer; transition: background .15s ease, color .15s ease; }
  .ex__tab:hover { background: #eef3ff; color: var(--brand); }
  .ex__tab[aria-selected="true"] { background: var(--navy); color: #fff; }
  .ex__tab--lic { margin-left: auto; background: linear-gradient(135deg, #fff7e6, #ffefd1); color: #8a4b00; border: 1px solid #f5d08a; }
  .ex__tab--lic:hover { background: linear-gradient(135deg, #ffefd1, #ffe3ad); color: #6b3a00; }
  @media (max-width: 1100px) { .ex__tab--lic { margin-left: 0; } }
  .ex__panel { display: grid; grid-template-columns: .9fr 1.1fr; gap: 28px; align-items: center; padding: clamp(22px, 3.5vw, 40px); }
  .ex__panel[hidden] { display: none; }
  .ex__k { font-size: 12.5px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--brand); }
  .ex__t { font-size: clamp(23px, 2.5vw, 31px); margin-top: 10px; }
  .ex__lead { margin-top: 12px; color: var(--ink-soft); font-size: 16px; }
  .ex__list { list-style: none; padding: 0; margin: 20px 0 24px; display: grid; gap: 11px; }
  .ex__list li { display: flex; gap: 10px; align-items: flex-start; }
  .ex :global(.ex__ck) { color: var(--brand); flex-shrink: 0; margin-top: 4px; }
  .ex__li { font-size: 15px; color: var(--ink-soft); line-height: 1.5; }
  .ex__li strong { color: var(--ink); }
  .ex__visual { min-width: 0; }
  @media (max-width: 980px) { .ex__panel { grid-template-columns: 1fr; } }

  .more { margin-top: 36px; }
  .more__k { font-weight: 700; color: var(--ink); text-align: center; }
  .more__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 16px; }
  .more__item { display: flex; align-items: center; gap: 14px; padding: 16px 18px; background: #fff; border: 1px solid var(--line); border-radius: var(--r-md); transition: border-color .2s ease, transform .2s ease; }
  .more__item:hover { border-color: var(--brand); transform: translateY(-2px); }
  .more__ic { flex-shrink: 0; width: 42px; height: 42px; border-radius: 11px; display: grid; place-items: center; background: var(--grad-brand-soft); color: var(--brand); }
  .more__t { font-weight: 700; color: var(--ink); font-size: 15px; }

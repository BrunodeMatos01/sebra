---
import Base from "../layouts/Base.astro";
import Faq from "../components/Faq.astro";
import ContactSection from "../components/ContactSection.astro";
import Icon from "../components/Icon.astro";
import HeroFx from "../components/HeroFx.astro";
import Brand from "../components/Brand.astro";
import Stage from "../components/mock/Stage.astro";
import Mock from "../components/mock/Mock.astro";
import MockFinanceiro from "../components/mock/MockFinanceiro.astro";
import MockOrcamento from "../components/mock/MockOrcamento.astro";
import MockLicitacao from "../components/mock/MockLicitacao.astro";
import MockDre from "../components/mock/MockDre.astro";
import MockContrato from "../components/mock/MockContrato.astro";
import { faqHome } from "../data/faq";
import { solucoes, getSolucao } from "../data/solucoes";
import { segmentos } from "../data/segmentos";
import { foco } from "../data/nav";
import MockFluxo from "../components/mock/MockFluxo.astro";
import { tipos as tiposAuto, provas as provasAuto } from "../data/automacoes";
import { waLink, waMsg } from "../data/site";
import { getCollection } from "astro:content";
import "../styles/prose.css";
const guiasHome = (await getCollection("guias")).filter((g) => g.data.destaque).slice(0, 3);

// Abas do explorador: os módulos mais fortes, nesta ordem.
const abas = ["financeiro", "orcamentos", "fiscal", "estoque", "servicos", "compras"].map((s) => getSolucao(s)!);
const pick = (s: (typeof solucoes)[number]) => {
  const itens = s.groups.flatMap((g) => g.items);
  const destaques = s.highlights.map((h) => h.title);
  return [...s.highlights, ...itens.filter((i) => !destaques.includes(i.title))].slice(0, 6);
};
const nFuncoes = (x: (typeof solucoes)[number]) => x.groups.reduce((n, g) => n + g.items.length, 0);
const totalFuncoes = solucoes.reduce((n, x) => n + nFuncoes(x), 0);
const fluxo = [
  { i: "file", t: "Orçamento" }, { i: "receipt", t: "Nota fiscal" }, { i: "wallet", t: "Conta a receber" },
  { i: "bank", t: "Baixa pelo extrato" }, { i: "chart", t: "Lucro do mês" },
];
const numeros = [
  { n: String(solucoes.length), l: "módulos integrados" },
  { n: `${Math.floor(totalFuncoes / 10) * 10}+`, l: "funções prontas" },
  { n: "Ilimitadas", l: "notas NF-e, NFS-e e NFC-e" },
  { n: "1", l: "sistema só, sem planilha" },
];
const outros = solucoes.filter((s) => foco.includes(s.slug) && !abas.includes(s));
// Nome curto na aba (cabe tudo numa linha); o nome completo aparece no painel.
const curto: Record<string, string> = { estoque: "Estoque", servicos: "Serviços" };

const jornadaGov = [
  { i: "search", t: "Edital", d: "Busca no PNCP" }, { i: "shield", t: "Habilitação", d: "Certidões em dia" },
  { i: "gavel", t: "Disputa", d: "Prazos e lances" }, { i: "contract", t: "Contrato", d: "Saldo e vigência" },
  { i: "landmark", t: "Empenho", d: "Calculado sozinho" }, { i: "receipt", t: "Nota", d: "Com retenções" },
  { i: "bank", t: "Recebimento", d: "Baixa automática" }, { i: "chart", t: "Lucro", d: "Por licitação" },
];
const seguranca = [
  { i: "key", t: "Certificado protegido", d: "Guardado com criptografia" },
  { i: "lock", t: "Cada empresa no seu espaço", d: "Os dados de uma empresa nunca aparecem para outra" },
  { i: "eye", t: "Acesso por perfil", d: "Cada pessoa vê só o que precisa" },
  { i: "history", t: "Tudo fica registrado", d: "Quem fez, o quê e quando" },
];
const etapas = [
  { t: "Diagnóstico", d: "Entendemos sua operação e o que precisa ligar" },
  { t: "Coleta", d: "Reunimos cadastros, certificado e saldos" },
  { t: "Validação", d: "Conferimos os dados antes de importar" },
  { t: "Importação", d: "Trazemos clientes, produtos e contas" },
  { t: "Homologação", d: "Testamos com você o dia a dia" },
  { t: "Go-live", d: "Liberamos e seguimos acompanhando" },
];
---
<Base
  title="Sistema de Licitação e ERP para Empresas | Sebra"
  description="Sistema de licitação com busca no PNCP, certidões, contratos e empenhos, mais ERP com notas fiscais, financeiro e estoque, para ver funcionando no WhatsApp."
  faq={faqHome}
  product
>
  <!-- 1. HERÓI -->
  <section class="hero showcase fx-host">
    <HeroFx />
    <div class="container hero__grid">
      <div class="hero__copy">
        
        <h1>Sistema de licitação e ERP para a sua empresa <span class="accent">crescer</span>.</h1>
        <p class="hero__lead">Licitações, notas fiscais, estoque e financeiro num sistema só, com automações sob medida.</p>
        <div class="btn-row">
          <a class="btn btn--wa btn--lg" href={waLink(waMsg.geral)} target="_blank" rel="noopener"><Brand name="whatsapp" size={20} /> Falar com um especialista</a>
          <a class="btn btn--ghost btn--on-navy btn--lg" href="#modulos">Conhecer os módulos <Icon name="arrowDown" size={18} /></a>
        </div>
        <ul class="hero__proof">
          <li><Icon name="check" size={16} stroke={2.6} />Sistema de licitação completo</li>
          <li><Icon name="check" size={16} stroke={2.6} />Notas fiscais ilimitadas</li>
          <li><Icon name="check" size={16} stroke={2.6} />Automações sob medida</li>
        </ul>
      </div>
      <div class="hero__visual">
        <div class="cascade">
          <div class="cascade__item"><MockLicitacao /></div>
          <div class="cascade__item"><MockOrcamento /></div>
          <div class="cascade__item"><MockFinanceiro /></div>
        </div>
        <p class="demo-tag">Telas da plataforma com dados de demonstração.</p>
      </div>
    </div>
    <a class="hero__scroll" href="#segmentos" aria-label="Rolar para a próxima seção"><Icon name="arrowDown" size={20} stroke={2.2} /></a>
  </section>

  <!-- 2. QUAL É O SEU RAMO -->
  <section class="ramos" id="segmentos" aria-labelledby="ramos-t">
    <div class="container">
      <div class="ramos__head">
        <h2 id="ramos-t">Qual é o seu ramo?</h2>
        <p>Escolha o seu e veja o sistema do seu jeito.</p>
      </div>
      <div class="ramos__grid">
        {segmentos.map((s) => (
          <a class="ramo" href={`/segmentos/${s.slug}/`}>
            <div class="ramo__ic"><Icon name={s.icon} size={18} /></div>
            <div class="ramo__tx"><p class="ramo__t">{s.nav}</p><p class="ramo__d">{s.menuDesc}</p></div>
            <Icon name="arrow" size={17} class="ramo__go" />
          </a>
        ))}
        <a class="ramo ramo--gov" href="/licitacoes/">
          <div class="ramo__ic"><Icon name="landmark" size={18} /></div>
          <div class="ramo__tx"><p class="ramo__t">Fornecedores do governo</p><p class="ramo__d">Licitações, contratos e empenhos</p></div>
          <Icon name="arrow" size={17} class="ramo__go" />
        </a>
      </div>
    </div>
  </section>

  <!-- 3. EXPLORADOR DE MÓDULOS -->
  <section class="section section--tint" id="modulos">
    <div class="container">
      <div class="s-head s-head--center reveal">
        
        <h2>Módulos completos num sistema só</h2>
      </div>

      <ol class="flow reveal" aria-label="Como os módulos se ligam">
        {fluxo.map((p, i) => (
          <li class="flow__i" style={`--d:${i}`}><span class="flow__ic"><Icon name={p.i} size={18} /></span>{p.t}</li>
        ))}
      </ol>

      <dl class="nums reveal">
        {numeros.map((x) => <div class="nums__i"><dt>{x.l}</dt><dd>{x.n}</dd></div>)}
      </dl>

      <div class="ex reveal" data-tabs>
        <div class="ex__tabs" role="tablist" aria-label="Módulos da Sebra">
          {abas.map((s, i) => (
            <button class="ex__tab" type="button" role="tab" id={`tab-${s.slug}`} aria-controls={`pan-${s.slug}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
              <Icon name={s.icon} size={17} />{curto[s.slug] ?? s.nav}
            </button>
          ))}
          <a class="ex__tab ex__tab--lic" href="/licitacoes/"><Icon name="gavel" size={17} />Licitações</a>
        </div>
        {abas.map((s, i) => (
          <div class="ex__panel" role="tabpanel" id={`pan-${s.slug}`} aria-labelledby={`tab-${s.slug}`} hidden={i !== 0}>
            <div class="ex__copy">
              <h3 class="ex__t">{s.title}</h3>
              <ul class="ex__list">
                {pick(s).map((f) => <li><Icon name="check" size={16} stroke={2.6} class="ex__ck" /><span class="ex__li">{f.title}</span></li>)}
              </ul>
              <ul class="ex__groups" aria-label="Áreas do módulo">
                {s.groups.map((g) => <li><Icon name={g.icon} size={14} />{g.title}</li>)}
              </ul>
              <div class="ex__foot">
                <a class="btn btn--primary" href={`/solucoes/${s.slug}/`}>Ver as {nFuncoes(s)} funções <Icon name="arrow" size={18} /></a>
              </div>
            </div>
            <div class="ex__visual"><Stage face="right" tilt={7} class="light"><Mock m={s.mock} /></Stage></div>
          </div>
        ))}
      </div>

      <div class="more">
        <p class="more__k">E ainda:</p>
        <div class="more__grid">
          {outros.map((s) => (
            <a class="more__item" href={`/solucoes/${s.slug}/`}>
              <div class="more__ic"><Icon name={s.icon} size={17} /></div>
              <div><p class="more__t">{s.nav}</p><p class="more__d">{s.menuDesc}</p></div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 3b. AUTOMAÇÕES -->
  <section class="section showcase" id="automacoes">
    <div class="container split">
      <div class="split__copy reveal">
        
        <h2>Além do sistema, automatizamos os processos da sua empresa</h2>
        <p class="split__lead">Robôs, integrações e fluxos sob medida, com o sistema que você já usa ou com a Sebra.</p>
        <ul class="auto-tipos">
          {tiposAuto.map((t) => <li><div class="auto-tipos__ic"><Icon name={t.i} size={18} /></div><div><p class="auto-tipos__t">{t.t}</p><p class="auto-tipos__d">{t.d}</p></div></li>)}
        </ul>
        <div class="btn-row">
          <a class="btn btn--light btn--lg" href="/automacoes/">Conhecer as automações</a>
          <a class="btn btn--wa btn--lg" href={waLink("Olá! Quero automatizar processos da minha empresa.")} target="_blank" rel="noopener"><Brand name="whatsapp" size={20} /> Quero automatizar</a>
        </div>
      </div>
      <div class="split__visual reveal" data-delay="1"><Stage face="left" tilt={9}><MockFluxo /></Stage></div>
    </div>
    <div class="container">
      <p class="auto-prova__k reveal">Automações que já rodam dentro da Sebra:</p>
      <div class="auto-prova reveal">
        {provasAuto.map((p) => <p class="auto-prova__i"><Icon name="zap" size={15} />{p.t}</p>)}
      </div>
    </div>
  </section>

  <!-- 4. LUCRO REAL -->
  <section class="section showcase">
    <div class="container split">
      <div class="split__copy reveal">
        
        <h2>Quanto a sua empresa lucrou este mês?</h2>
        <p class="split__lead">O DRE se monta sozinho a partir das notas e dos lançamentos.</p>
        <ul class="check-list">
          <li><strong>DRE por competência</strong> e fluxo de caixa por período</li>
          <li><strong>Resultado das vendas</strong> calculado pelas notas autorizadas</li>
          <li><strong>Conciliação automática</strong>: o extrato dá baixa nas notas pagas</li>
          <li><strong>Boleto</strong> com baixa automática quando é pago</li>
        </ul>
        <a class="btn btn--light" href="/solucoes/financeiro/">Ver todas as funções do financeiro <Icon name="arrow" size={18} /></a>
      </div>
      <div class="split__visual reveal" data-delay="1"><Stage face="left" tilt={9}><MockDre /></Stage></div>
    </div>
  </section>

  <!-- 5. FATOS -->
  <section class="section facts">
    <div class="container">
      <div class="facts__grid">
        <div class="fact reveal"><div class="fact__ic"><Icon name="receipt" size={18} /></div><p class="fact__n">Nota fiscal completa</p><p class="fact__l">NF-e, NFS-e e NFC-e emitidas por emissor homologado</p></div>
        <div class="fact reveal" data-delay="1"><div class="fact__ic"><Icon name="zap" size={18} /></div><p class="fact__n">Financeiro no automático</p><p class="fact__l">O extrato do banco dá baixa nas notas pagas sozinho</p></div>
        <div class="fact reveal" data-delay="2"><div class="fact__ic"><Icon name="shield" size={18} /></div><p class="fact__n">Documentos protegidos</p><p class="fact__l">Notas e XMLs guardados com segurança e cópia de segurança</p></div>
        <div class="fact reveal" data-delay="3"><div class="fact__ic"><Icon name="key" size={18} /></div><p class="fact__n">Certificado cifrado</p><p class="fact__l">Seu certificado digital protegido com criptografia</p></div>
      </div>
    </div>
  </section>

  <!-- 6. LICITAÇÕES -->
  <section class="section showcase gov" id="licitacoes">
    <div class="container">
      <div class="s-head s-head--center reveal">
        
        <h2>Vende para o governo? Aqui a Sebra é especialista.</h2>
        <p>A Sebra acompanha a disputa e continua depois da vitória.</p>
      </div>
      <ol class="gov__steps reveal">
        {jornadaGov.map((j) => <li><div class="gov__ic"><Icon name={j.i} size={19} /></div><p class="gov__t">{j.t}</p><p class="gov__d">{j.d}</p></li>)}
      </ol>
      <div class="split gov__split">
        <div class="split__copy reveal">
          <ul class="check-list">
            <li><strong>Busca de editais no PNCP</strong></li>
            <li><strong>Quadro Kanban</strong> ligado à licitação</li>
            <li><strong>Certidões com aviso</strong> antes de vencer</li>
            <li><strong>Saldo de contrato e de empenho</strong></li>
            <li><strong>Resultado por licitação</strong></li>
          </ul>
          <div class="btn-row">
            <a class="btn btn--light btn--lg" href="/licitacoes/">Conhecer o módulo de licitações</a>
            <a class="btn btn--wa btn--lg" href={waLink(waMsg.licitacao)} target="_blank" rel="noopener"><Brand name="whatsapp" size={20} /> Ver funcionando</a>
          </div>
        </div>
        <div class="split__visual reveal" data-delay="1"><Stage face="left" tilt={9}><MockContrato /></Stage></div>
      </div>
    </div>
  </section>

  <!-- 7. CONFIANÇA -->
  <section class="section">
    <div class="container">
      <div class="s-head s-head--center reveal">
        
        <h2>Seus dados protegidos</h2>
      </div>
      <div class="grid grid--4 trust">
        {seguranca.map((s, i) => (
          <article class="card reveal" data-delay={i}>
            <div class="card__icon"><Icon name={s.i} size={18} /></div>
            <h3>{s.t}</h3><p>{s.d}</p>
          </article>
        ))}
      </div>
      <p class="trust__more reveal"><a class="link-arrow" href="/seguranca/">Como protegemos seus dados <Icon name="arrow" size={16} /></a></p>

      <div class="steps reveal">
        <div class="steps__head">
          <h3>Como colocamos a Sebra para rodar na sua empresa</h3>
          <p>Conduzida pela nossa equipe, enquanto você continua trabalhando</p>
        </div>
        <ol class="steps__list">
          {etapas.map((e, i) => (
            <li><p class="steps__n">{String(i + 1).padStart(2, "0")}</p><p class="steps__t">{e.t}</p><p class="steps__d">{e.d}</p></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 7b. GUIAS -->
  {guiasHome.length > 0 && (
    <section class="section" id="guias">
      <div class="container">
        <div class="s-head reveal"><h2>Guias gratuitos</h2></div>
        <div class="guia-grid reveal" style="margin-top:28px">
          {guiasHome.map((g) => (
            <a class="guia-card" href={`/guias/${g.id}/`}>
              <span class="guia-card__cat">{g.data.categoria}</span>
              <h3>{g.data.title}</h3>
              <span class="guia-card__go">Ler o guia <Icon name="arrow" size={15} /></span>
            </a>
          ))}
        </div>
        <p style="margin-top:24px"><a class="btn btn--ghost" href="/guias/">Ver todos os guias <Icon name="arrow" size={16} /></a></p>
      </div>
    </section>
  )}

  <!-- 8. FAQ -->
  <section class="section section--soft">
    <div class="container">
      <div class="s-head s-head--center reveal">
        
        <h2>Perguntas frequentes</h2>
      </div>
      <div class="reveal" style="margin-top:32px"><Faq items={faqHome} /></div>
    </div>
  </section>

  <!-- 9. PLANOS + CONTATO -->
  <section class="cta-band">
    <div class="container cta-band__inner reveal">
      <div>
        <h2>Planos a partir de R$ 327 por mês</h2>
        <p>Notas fiscais ilimitadas em todos os planos.</p>
      </div>
      <div class="btn-row">
        <a class="btn btn--light btn--lg" href="/planos/">Ver os planos</a>
        <a class="btn btn--wa btn--lg" href={waLink(waMsg.planos)} target="_blank" rel="noopener"><Brand name="whatsapp" size={20} /> Falar agora</a>
      </div>
    </div>
  </section>

  <ContactSection origem="Página inicial" uid="home" />
</Base>

<script>
  // Abas do explorador (teclado: setas esquerda/direita)
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('button[role="tab"]')];
    const select = (t: HTMLButtonElement, focus = false) => {
      tabs.forEach((x) => {
        const on = x === t;
        x.setAttribute("aria-selected", String(on));
        x.tabIndex = on ? 0 : -1;
        const pan = document.getElementById(x.getAttribute("aria-controls")!);
        if (pan) pan.hidden = !on;
      });
      if (focus) t.focus();
      window.dispatchEvent(new Event("resize"));
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(t));
      t.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") select(tabs[(i + 1) % tabs.length], true);
        if (e.key === "ArrowLeft") select(tabs[(i - 1 + tabs.length) % tabs.length], true);
      });
    });
  });
</script>

<style>
  /* HERÓI */
  .hero { position: relative; isolation: isolate; min-height: calc(100svh - var(--nav-h)); display: flex; flex-direction: column; justify-content: center; padding-block: clamp(40px, 5vw, 64px) 20px; background: #050a24; }
  .hero > .container { position: relative; z-index: 1; }
  @media (max-width: 940px) { .hero { min-height: 0; } }
  .hero__grid { display: grid; grid-template-columns: 1.08fr 1fr; gap: clamp(20px, 2.5vw, 32px); align-items: center; }
  .hero h1 { text-wrap: pretty; font-weight: 600; font-size: clamp(34px, 4vw, 56px); color: #fff; letter-spacing: -.035em; line-height: 1.05; background: linear-gradient(180deg, #fff 30%, #c9d8ff 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .hero h1 .accent { background: linear-gradient(90deg, #6ea0ff, #a78bfa 60%, #67e8f9); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .hero__lead { margin-top: 18px; font-size: 17.5px; color: var(--on-dark-soft); max-width: 560px; line-height: 1.62; }
  .hero .btn-row { margin-top: 26px; }
  .hero__proof { list-style: none; padding: 0; margin: 28px 0 0; display: flex; flex-wrap: wrap; gap: 10px 22px; }
  .hero__proof li { display: inline-flex; align-items: center; gap: 7px; font-size: 14px; color: var(--on-dark-soft); }
  .hero__proof :global(svg) { color: #4ade80; }
  .hero__visual { min-width: 0; margin-right: calc(-1 * clamp(0px, 5vw, 96px)); }
  .hero__visual .demo-tag { text-align: left; margin-top: 0; padding-left: 4px; }
  /* Seta de rolagem */
  .hero__scroll { position: absolute; z-index: 2; left: 50%; bottom: 22px; transform: translateX(-50%); display: grid; place-items: center; width: 44px; height: 44px; border-radius: 999px; color: #dbe6ff; background: rgba(255,255,255,.06); border: 1px solid rgba(160,190,255,.28); backdrop-filter: blur(6px); transition: background .2s ease, border-color .2s ease; }
  .hero__scroll:hover { background: rgba(255,255,255,.14); border-color: rgba(190,210,255,.6); }
  .hero__scroll :global(svg) { animation: scrollNudge 1.8s ease-in-out infinite; }
  .hero__scroll::before { content: ""; position: absolute; inset: -6px; border-radius: inherit; border: 1px solid rgba(110,160,255,.35); animation: scrollRing 2.4s ease-out infinite; }
  @keyframes scrollNudge { 0%, 100% { transform: translateY(-3px); opacity: .7; } 50% { transform: translateY(4px); opacity: 1; } }
  @keyframes scrollRing { from { transform: scale(.85); opacity: .9; } to { transform: scale(1.35); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .hero__scroll :global(svg), .hero__scroll::before { animation: none; } }
  @media (max-width: 940px) { .hero__visual { margin-right: 0; } .hero__scroll { display: none; } }
  @media (max-width: 940px) { .hero__grid { grid-template-columns: 1fr; } }

  /* AUTOMAÇÕES */
  .auto-tipos { list-style: none; padding: 0; margin: 24px 0 28px; display: grid; grid-template-columns: 1fr 1fr; gap: 14px 18px; }
  .auto-tipos li { display: flex; gap: 12px; align-items: flex-start; }
  .auto-tipos__ic { flex-shrink: 0; width: 32px; height: 32px; border-radius: 8px; display: grid; place-items: center; background: rgba(245,158,11,.16); color: #fbbf24; }
  .auto-tipos__t { font-weight: 600; color: #fff; font-size: 14.5px; }
  .auto-tipos__d { color: var(--on-dark-soft); font-size: 13.5px; margin-top: 2px; line-height: 1.45; }
  .auto-prova__k { text-align: center; color: var(--on-dark-mute); font-size: 14px; margin-top: 10px; }
  .auto-prova { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 14px; }
  .auto-prova__i { display: inline-flex; align-items: center; gap: 7px; padding: 6px 12px; border-radius: 999px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); color: var(--on-dark-soft); font-size: 14px; }

---
import HeroFx from "../components/HeroFx.astro";
import Base from "../layouts/Base.astro";
import ContactSection from "../components/ContactSection.astro";
import Icon from "../components/Icon.astro";
import "../styles/internal.css";

// Só integrações que existem em produção (conferido no código em 16/11/2026).
const grupos = [
  { i: "landmark", nome: "Governo e licitações", itens: ["PNCP: busca de editais abertos", "CINCATARINA: leitura das AFs em PDF", "Receita Federal: cadastro pelo CNPJ"] },
  { i: "receipt", nome: "Fiscal", itens: ["Emissão por emissor homologado (Focus NFe)", "SEFAZ e prefeituras: NF-e, NFS-e e NFC-e", "IBPT: tributos aproximados", "Certificado digital A1"] },
  { i: "bank", nome: "Bancos e recebimento", itens: ["Sicoob: boleto registrado com baixa automática", "Open Finance: sincronização do extrato", "Extrato em OFX", "Extrato em PDF (C6)"] },
  { i: "chat", nome: "Comunicação", itens: ["WhatsApp", "Telegram", "E-mail (SMTP) para notas e boletos", "Chamadas de voz e vídeo"] },
  { i: "clock", nome: "Agenda e produtividade", itens: ["Google Calendar", "Outlook", "Google Meet", "Exportação Excel e PDF"] },
  { i: "bot", nome: "Inteligência artificial", itens: ["Assistente de IA dentro do sistema", "Leitura de boleto por foto e de XML", "Conectores de IA (plugins)"] },
];
---
<Base
  title="Integrações: PNCP, SEFAZ, bancos e mais | Sebra ERP com IA"
  description="Veja todas as integrações do ERP para quem vende ao governo, com conexão ao PNCP, à SEFAZ, ao Sicoob, ao Open Finance, ao WhatsApp e ao Google."
  crumbs={[{ name: "Integrações", href: "/integracoes/" }]}
>
  <section class="ip-hero showcase fx-host">
    <HeroFx />
    <div class="container">
      <div class="s-head s-head--center" style="margin-inline:auto">
        <p class="ip-crumbs ip-crumbs--dark" style="text-align:center"><a href="/">Início</a> · Integrações</p>
        
        <h1>Conectada ao governo, ao banco e ao que você já usa</h1>
        <p class="ip-hero__lead" style="margin-inline:auto">Do portal oficial de contratações ao extrato do seu banco.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        {grupos.map((g, i) => (
          <article class="card reveal" data-delay={i % 3}>
            <div class="card__icon"><Icon name={g.i} size={22} /></div>
            <h2 class="int-h">{g.nome}</h2>
            <ul class="int-list">{g.itens.map((it) => <li><Icon name="check" size={15} stroke={2.6} />{it}</li>)}</ul>
          </article>
        ))}
      </div>
      <p class="reveal" style="text-align:center;margin-top:32px;color:var(--muted);font-size:15px">Se precisar de uma integração específica, fale com a nossa equipe e avaliamos a conexão com o seu sistema.</p>
    </div>
  </section>

  <ContactSection origem="Página de integrações" uid="integ" />
</Base>

<style>
  .int-h { font-size: 19px; }
  .int-list { list-style: none; padding: 0; margin: 14px 0 0; display: grid; gap: 9px; }
  .int-list li { display: flex; gap: 9px; align-items: flex-start; font-size: 14.5px; color: var(--ink-soft); }
  .int-list li :global(svg) { color: var(--brand); flex-shrink: 0; margin-top: 4px; }
</style>

---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import "../styles/internal.css";

const valores = [
  { t: "Uma plataforma, não um remendo", d: "Acreditamos que a empresa não deveria pagar por cinco sistemas que não conversam. Por isso a Sebra faz tudo num lugar só." },
  { t: "Feita para o Brasil", d: "Nota fiscal, certidões, Open Finance, PIX. A Sebra fala a língua da burocracia brasileira para você não precisar." },
  { t: "IA que trabalha, não que enfeita", d: "Nossa IA atende, qualifica e antecipa problemas. Ela existe para dar tempo de volta ao seu time." },
  { t: "Gente de verdade no suporte", d: "Implantação conduzida e atendimento por WhatsApp com pessoas que entendem a sua operação." },
];
---
<Base title="Quem somos | Sebra" description="A Sebra nasceu para unir a operação inteira de uma empresa numa plataforma só, com inteligência artificial e conexão real com o governo brasileiro.">
  <section class="ip-hero">
    <div class="container">
      <div class="s-head s-head--center reveal" style="margin-inline:auto">
        <p class="ip-crumbs" style="text-align:center"><a href="/">Início</a> · Empresa</p>
        <span class="eyebrow">Quem somos</span>
        <h1>Uma plataforma para a empresa inteira respirar</h1>
        <p>A Sebra existe para acabar com a bagunça de sistemas soltos. Reunimos atendimento, vendas, financeiro, fiscal, estoque e pessoas num lugar só — com IA trabalhando junto.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="reveal">
        <span class="eyebrow">Nosso propósito</span>
        <h2>Tecnologia que devolve tempo ao empresário</h2>
        <p class="split__lead">A maioria das empresas brasileiras opera no improviso: um sistema para cada coisa, planilhas paralelas e retrabalho. Nascemos para mudar isso — dar ao pequeno e médio negócio o mesmo poder de operação que só os grandes tinham, de um jeito simples e acessível.</p>
        <p style="margin-top:16px;color:var(--ink-soft)">Cada função da Sebra nasce de uma dor real de quem toca uma empresa no dia a dia. É por isso que ela cresce na direção certa: resolvendo problema, não empilhando recurso.</p>
      </div>
      <div class="reveal" data-delay="1">
        <div class="ip-panel">
          <div class="ip-panel__bar"><span></span><span></span><span></span><em>Sebra</em></div>
          <div class="ip-panel__body">
            <div class="ip-panel__chips">
              <span class="ip-panel__chip">Atendimento</span><span class="ip-panel__chip">Vendas</span>
              <span class="ip-panel__chip">Financeiro</span><span class="ip-panel__chip">Fiscal</span>
              <span class="ip-panel__chip">Estoque</span><span class="ip-panel__chip">RH</span>
              <span class="ip-panel__chip">IA</span>
            </div>
            <div class="ip-panel__line" style="margin-top:8px"></div>
            <div class="ip-panel__line" style="width:70%"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="s-head s-head--center reveal"><span class="eyebrow">No que acreditamos</span><h2>Os princípios da Sebra</h2></div>
      <div class="grid grid--2" style="margin-top:44px">
        {valores.map((v, i) => (
          <article class="card reveal" data-delay={i % 2}><h3>{v.t}</h3><p>{v.d}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section contact" id="contato">
    <div class="container contact__grid">
      <div class="reveal">
        <span class="eyebrow">Vamos nos conhecer</span>
        <h2 class="contact__title">Veja a Sebra por dentro</h2>
        <p class="contact__lead">Agende uma demonstração e entenda como a plataforma se encaixa na realidade da sua empresa.</p>
      </div>
      <div class="contact__form reveal" data-delay="1"><ContactForm /></div>
    </div>
  </section>
</Base>

<style>
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .split__lead { margin-top: 18px; font-size: 17px; color: var(--ink-soft); }
  .contact__grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: 56px; align-items: start; }
  .contact__title { margin-top: 14px; font-size: clamp(26px, 3vw, 38px); }
  .contact__lead { margin-top: 16px; font-size: 17px; color: var(--ink-soft); }
  .contact__form { background: #fff; border: 1px solid var(--line); border-radius: var(--r-lg); padding: 30px; box-shadow: var(--shadow); }
  @media (max-width: 940px) { .split, .contact__grid { grid-template-columns: 1fr; } }
</style>

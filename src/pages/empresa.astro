---
import HeroFx from "../components/HeroFx.astro";
import Base from "../layouts/Base.astro";
import ContactSection from "../components/ContactSection.astro";
import Icon from "../components/Icon.astro";
import Brand from "../components/Brand.astro";
import { site, waLink, waMsg } from "../data/site";
import "../styles/internal.css";

const principios = [
  { i: "layers", t: "Um sistema, não um remendo", d: "O orçamento vira nota, a nota vira conta a receber e o extrato dá a baixa." },
  { i: "checkCircle", t: "Prometer só o que existe", d: "Tudo o que está neste site funciona hoje na plataforma." },
  { i: "shield", t: "Responsabilidade com o seu dinheiro", d: "A baixa automática só acontece com soma exata, e o resto volta para uma pessoa decidir." },
  { i: "users", t: "Gente de verdade do outro lado", d: "Implantação e atendimento pela nossa equipe, no WhatsApp." },
];
---
<Base
  title="Quem somos | Sebra, sistema de gestão empresarial"
  description="Conheça quem está por trás da Sebra, o ERP brasileiro que reúne financeiro, notas, orçamentos, estoque, compras, equipe e licitações num sistema só."
  crumbs={[{ name: "Quem somos", href: "/empresa/" }]}
>
  <section class="ip-hero showcase fx-host">
    <HeroFx />
    <div class="container">
      <div class="s-head s-head--center" style="margin-inline:auto">
        <p class="ip-crumbs ip-crumbs--dark" style="text-align:center"><a href="/">Início</a> · Quem somos</p>
        
        <h1>Nascemos para dar controle de verdade a quem toca uma empresa</h1>
        <p class="ip-hero__lead" style="margin-inline:auto">A Sebra existe para acabar com sistemas que não conversam, planilhas paralelas e retrabalho.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="reveal">
        
        <h2>Toda empresa merece o controle que só os grandes tinham</h2>
        <p class="split__lead">Quanto vendi, quanto custou, quanto sobrou e quem me deve: a Sebra responde tudo num sistema só.</p>
        <p class="emp-p">E somos especialistas em quem vende para o governo.</p>
      </div>
      <div class="reveal" data-delay="1">
        <div class="vision">
          <p class="vision__q">"Sua empresa inteira num sistema só."</p>
          <p class="vision__a">É a frase que guia cada decisão de produto da Sebra.</p>
          <div class="vision__row">
            <div class="vision__cell"><p class="vision__k">Vender</p><p class="vision__v">orçamento, nota e cliente</p></div>
            <div class="vision__cell"><p class="vision__k">Controlar</p><p class="vision__v">estoque, compras e equipe</p></div>
            <div class="vision__cell"><p class="vision__k">Lucrar</p><p class="vision__v">financeiro e resultado</p></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="s-head s-head--center reveal"><h2>Os princípios da Sebra</h2></div>
      <div class="grid grid--2" style="margin-top:36px">
        {principios.map((v, i) => (
          <article class="card reveal" data-delay={i % 2}>
            <div class="card__icon"><Icon name={v.i} size={22} /></div>
            <h3>{v.t}</h3><p>{v.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--navy">
    <div class="container social reveal">
      <div>
        
        <h2>Bastidores, novidades e dicas de gestão</h2>
      </div>
      <div class="btn-row">
        <a class="btn btn--wa btn--lg" href={waLink(waMsg.geral)} target="_blank" rel="noopener"><Brand name="whatsapp" size={20} /> {site.whatsappDisplay}</a>
        <a class="btn btn--light btn--lg" href={site.instagram} target="_blank" rel="noopener"><Brand name="instagram" size={18} /> {site.instagramHandle}</a>
      </div>
    </div>
  </section>

  <ContactSection origem="Página Quem somos" uid="empresa" title="Vamos nos conhecer?" lead="Conte um pouco da sua empresa que respondemos pelo WhatsApp e, se fizer sentido, mostramos a Sebra rodando com o seu cenário." />
</Base>

<style>
  .emp-p { margin-top: 16px; color: var(--ink-soft); font-size: 17px; }
  .vision { border-radius: var(--r-lg); padding: clamp(26px, 4vw, 40px); background: linear-gradient(160deg, #071a4a, #04102e); box-shadow: var(--shadow-lg); }
  .vision__q { font-family: var(--font-display); font-weight: 600; font-size: clamp(22px, 2.4vw, 30px); line-height: 1.25; color: #fff; }
  .vision__a { margin-top: 12px; color: var(--on-dark-mute); }
  .vision__row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 26px; }
  .vision__cell { padding: 14px; border-radius: 12px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1); }
  .vision__k { color: #fff; font-family: var(--font-display); font-weight: 600; font-size: 15px; }
  .vision__v { color: var(--on-dark-soft); font-size: 13px; margin-top: 4px; }
  @media (max-width: 520px) { .vision__row { grid-template-columns: 1fr; } }
  .social { display: flex; justify-content: space-between; align-items: center; gap: 28px; flex-wrap: wrap; }
  .social h2 { font-size: clamp(24px, 2.8vw, 34px); max-width: 600px; }
</style>

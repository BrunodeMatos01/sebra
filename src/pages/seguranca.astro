---
import HeroFx from "../components/HeroFx.astro";
// Segurança. Padrão limpo e sem detalhe técnico: dizemos O QUE protegemos,
// não COMO (expor o mecanismo só ajuda quem quer atacar).
import Base from "../layouts/Base.astro";
import ContactSection from "../components/ContactSection.astro";
import Icon from "../components/Icon.astro";
import "../styles/internal.css";

const camadas = [
  { i: "key", t: "Certificado digital protegido", d: "Guardado com criptografia e usado só por quem tem permissão." },
  { i: "lock", t: "Cada empresa no seu espaço", d: "Os dados de uma empresa nunca aparecem para outra." },
  { i: "eye", t: "Acesso por perfil", d: "Cada pessoa vê e faz só o que precisa." },
  { i: "shield", t: "Verificação em duas etapas", d: "A conta continua protegida mesmo se a senha vazar." },
  { i: "history", t: "Tudo fica registrado", d: "Quem fez, o quê e quando." },
  { i: "checkCircle", t: "Aprovação por valor", d: "Despesas altas esperam a aprovação de quem decide." },
];
---
<Base
  title="Segurança e proteção de dados | Sebra ERP"
  description="Como a Sebra protege os dados da sua empresa: certificado digital protegido, dados separados por empresa, acesso por perfil, verificação em duas etapas e registro das ações."
  crumbs={[{ name: "Segurança", href: "/seguranca/" }]}
>
  <section class="ip-hero ip-hero--center showcase fx-host">
    <HeroFx />
    <div class="container">
      <h1>Seus dados protegidos</h1>
      <p class="ip-hero__lead">Notas, certificado e financeiro tratados como se fossem nossos.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        {camadas.map((c, i) => (
          <article class="card reveal" data-delay={i % 3}>
            <div class="card__icon"><Icon name={c.i} size={22} /></div>
            <h3>{c.t}</h3><p>{c.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ContactSection origem="Página de segurança" uid="seg" title="Tem alguma exigência de segurança?" />
</Base>

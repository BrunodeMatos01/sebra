---
import HeroFx from "../../components/HeroFx.astro";
import Base from "../../layouts/Base.astro";
import ContactSection from "../../components/ContactSection.astro";
import Faq from "../../components/Faq.astro";
import Icon from "../../components/Icon.astro";
import Brand from "../../components/Brand.astro";
import Stage from "../../components/mock/Stage.astro";
import Mock from "../../components/mock/Mock.astro";
import { segmentos } from "../../data/segmentos";
import { slugify } from "../../data/solucoes";
import { waLink } from "../../data/site";
import "../../styles/internal.css";

export function getStaticPaths() {
  return segmentos.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const waText = `Olá! ${s.wa} e quero ver como a Sebra funciona para o meu ramo.`;
const outros = segmentos.filter((o) => o.slug !== s.slug);
---
<Base title={s.seoTitle} description={s.seoDesc} crumbs={[{ name: "Segmentos", href: "/#segmentos" }, { name: s.nav, href: `/segmentos/${s.slug}/` }]} faq={s.faq} waText={waText}>
  <section class="ip-hero showcase fx-host">
    <HeroFx />
    <div class="container ip-hero__grid">
      <div>
        <p class="ip-crumbs ip-crumbs--dark"><a href="/">Início</a> · <a href="/#segmentos">Segmentos</a> · {s.nav}</p>
        
        <h1>{s.title}</h1>
        <p class="ip-hero__lead">{s.lead}</p>
        <div class="btn-row">
          <a class="btn btn--wa btn--lg" href={waLink(waText)} target="_blank" rel="noopener"><Brand name="whatsapp" size={20} /> Falar no WhatsApp</a>
          <a class="btn btn--ghost btn--on-navy btn--lg" href="/planos/">Ver planos</a>
        </div>
      </div>
      <div class="ip-hero__visual"><Stage face="left" tilt={9}><Mock m={s.mock} /></Stage></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="pain-list">
        {s.pains.map((p, i) => (
          <div class="pain reveal" data-delay={i % 3}>
            <div class="pain__problem"><p class="pain__tag">Sem a Sebra</p><p>{p.problem}</p></div>
            <div class="pain__answer"><p class="pain__tag">Com a Sebra</p><p>{p.answer}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="s-head s-head--center reveal">
        
        <h2>O que a Sebra faz por {s.nav.toLowerCase()}</h2>
      </div>
      <div class="sfeat">
        {s.features.map((f, i) => (
          <article class="sfeat__item reveal" id={slugify(f.title)} data-delay={i % 4}>
            <div class="sfeat__ic"><Icon name="check" size={18} stroke={2.4} /></div>
            <h3>{f.title}</h3><p>{f.desc}</p>
          </article>
        ))}
      </div>
      <div class="smods reveal">
        <p class="smods__k">Módulos que você vai usar</p>
        <div class="smods__list">
          {s.modulos.map((m) => <a href={m.href}>{m.nome}<Icon name="arrow" size={15} /></a>)}
        </div>
      </div>
    </div>
  </section>

  {s.gov && (
    <section class="section section--navy">
      <div class="container gov-band reveal">
        <div class="gov-band__ic"><Icon name="landmark" size={30} /></div>
        <div>
          
          <p class="gov-band__t">{s.gov}</p>
        </div>
        <a class="btn btn--light btn--lg" href="/licitacoes/">Ver licitações e contratos</a>
      </div>
    </section>
  )}

  <section class="section section--soft">
    <div class="container">
      <div class="s-head s-head--center reveal"><h2>Dúvidas de quem é de {s.nav.toLowerCase()}</h2></div>
      <div class="reveal" style="margin-top:40px"><Faq items={s.faq} /></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="s-head reveal"><h2>A Sebra também atende</h2></div>
      <div class="seg-links">
        {outros.map((o) => <a class="reveal" href={`/segmentos/${o.slug}/`}><Icon name={o.icon} size={18} />{o.nav}</a>)}
        <a class="reveal" href="/licitacoes/"><Icon name="landmark" size={18} />Fornecedores do governo</a>
      </div>
    </div>
  </section>

  <ContactSection origem={`Segmento ${s.nav}`} uid={`seg-${s.slug}`} waText={waText} title={s.closing}
    lead="Preencha uma vez e abrimos o WhatsApp com a mensagem pronta, para mostrar a Sebra rodando no contexto do seu ramo." />
</Base>

<style>
  .sfeat { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 36px; }
  .sfeat__item { background: #fff; border: 1px solid var(--line); border-radius: var(--r-md); padding: 22px; }
  .sfeat__ic { width: 40px; height: 40px; border-radius: 11px; display: grid; place-items: center; background: var(--grad-brand-soft); color: var(--brand); margin-bottom: 14px; }
  .sfeat__item h3 { font-family: var(--font); font-size: 16.5px; font-weight: 600; letter-spacing: 0; }
  .sfeat__item p { font-size: 14.5px; color: var(--ink-soft); margin-top: 6px; }
  @media (max-width: 980px) { .sfeat { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .sfeat { grid-template-columns: 1fr; } }
  .smods { margin-top: 36px; text-align: center; }
  .smods__k { font-weight: 600; color: var(--ink); }
  .smods__list { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 14px; }
  .smods__list a { display: inline-flex; align-items: center; gap: 8px; height: 42px; padding: 0 16px; border-radius: 999px; background: #fff; border: 1px solid var(--line-strong); font-weight: 600; color: var(--ink); }
  .smods__list a:hover { border-color: var(--brand); color: var(--brand); }
  .gov-band { display: grid; grid-template-columns: auto 1fr auto; gap: 28px; align-items: center; }
  .gov-band__t { font-family: var(--font-display); font-size: clamp(19px, 2vw, 25px); line-height: 1.4; color: #fff; font-weight: 600; }
  .gov-band__ic { width: 68px; height: 68px; border-radius: 18px; display: grid; place-items: center; background: rgba(110,160,255,.16); color: var(--brand-light); }
  @media (max-width: 860px) { .gov-band { grid-template-columns: 1fr; } }
  .seg-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .seg-links a { display: inline-flex; align-items: center; gap: 9px; height: 46px; padding: 0 18px; border-radius: 12px; background: #fff; border: 1px solid var(--line); font-weight: 600; color: var(--ink); }
  .seg-links a:hover { border-color: var(--brand); color: var(--brand); }
</style>

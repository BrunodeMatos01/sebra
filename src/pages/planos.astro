---
import Base from "../layouts/Base.astro";
import ContactSection from "../components/ContactSection.astro";
import Icon from "../components/Icon.astro";
import Brand from "../components/Brand.astro";
import { planos } from "../data/planos";
import { waMsg } from "../data/site";
import "../styles/internal.css";

const base = planos.filter((p) => !p.addon);
const addon = planos.find((p) => p.addon)!;
const inclusos = [
  { i: "handshake", t: "Implantação conduzida", d: "Nossa equipe configura, importa seus dados e testa com você." },
  { i: "chat", t: "Suporte pelo WhatsApp", d: "Gente que entende de gestão e de financeiro do outro lado." },
  { i: "lock", t: "Segurança de verdade", d: "Certificado cifrado, permissões por perfil e auditoria." },
  { i: "layers", t: "Atualizações contínuas", d: "Novas funções entram sem reinstalar nada." },
];
const faqPlanos = [
  { q: "Posso começar por um plano e mudar depois?", a: "Sim. Os planos são modulares: você começa pelo que precisa e ativa mais módulos quando a empresa pedir." },
  { q: "O módulo de licitações funciona com qualquer plano?", a: "Sim. Licitações e Contratos Públicos se soma a qualquer plano e conversa com as notas, o estoque, as compras e o financeiro." },
  { q: "A implantação está incluída?", a: "A implantação é conduzida pela nossa equipe em todos os planos: configuramos, importamos seus dados e testamos com você antes de liberar." },
  { q: "Quanto custa a Sebra?", a: "O plano Essencial custa R$ 417 por mês e o Profissional R$ 689 por mês. O Empresarial e o módulo de Licitações são montados sob medida: escolha, preencha o formulário e falamos pelo WhatsApp com a proposta." },
];
---
<Base
  title="Planos e preços do ERP Sebra"
  description="Planos Essencial, Profissional e Empresarial para empresas de todos os ramos, e o módulo de Licitações para quem vende ao governo. Fale pelo WhatsApp."
  crumbs={[{ name: "Planos", href: "/planos/" }]}
  faq={faqPlanos}
  waText={waMsg.planos}
>
  <section class="ip-hero showcase plans-hero">
    <div class="container">
      <div class="s-head s-head--center" style="margin-inline:auto">
        <p class="ip-crumbs ip-crumbs--dark" style="text-align:center"><a href="/">Início</a> · Planos</p>
        <p class="eyebrow">Planos</p>
        <h1>Um plano para cada momento da sua empresa</h1>
        <p class="ip-hero__lead" style="margin-inline:auto">Comece pelo que você precisa e cresça sem trocar de sistema. Escolha o plano, preencha uma vez e fale com a gente no WhatsApp com tudo explicado.</p>
      </div>
    </div>
  </section>

  <section class="section plans-sec">
    <div class="container">
      <div class="plans">
        {base.map((p, i) => (
          <article class={`plan reveal${p.destaque ? " plan--hot" : ""}`} data-delay={i}>
            {p.destaque && <p class="plan__flag">Mais completo para crescer</p>}
            <h2 class="plan__name">{p.nome}</h2>
            <p class="plan__for">{p.publico}</p>
            <div class="plan__price">
              {p.preco ? (
                <><p class="plan__val">{p.preco.valor}{p.preco.periodo && <small>{p.preco.periodo}</small>}</p>{p.preco.nota && <p class="plan__note">{p.preco.nota}</p>}</>
              ) : (
                <><p class="plan__val plan__val--q">Valor sob consulta</p><p class="plan__note">Proposta sob medida pelo WhatsApp</p></>
              )}
            </div>
            <p class="plan__resume">{p.resumo}</p>
            <ul class="plan__list">
              {p.itens.map((it) => <li><Icon name="check" size={16} stroke={2.6} class="plan__ck" />{it}</li>)}
            </ul>
            <button class={`btn ${p.destaque ? "btn--wa" : "btn--primary"} btn--lg plan__cta`} type="button" data-lead data-plano={p.nome}>
              <Brand name="whatsapp" size={19} /> Quero o plano {p.nome}
            </button>
          </article>
        ))}
      </div>

      <article class="addon reveal">
        <div class="addon__head">
          <div class="addon__ic"><Icon name="gavel" size={26} /></div>
          <div>
            <p class="addon__tag">Módulo adicional · soma-se a qualquer plano</p>
            <h2 class="addon__name">{addon.nome}</h2>
            <p class="addon__for">{addon.publico} {addon.resumo}</p>
          </div>
        </div>
        <ul class="addon__list">
          {addon.itens.map((it) => <li><Icon name="check" size={16} stroke={2.6} class="addon__ck" />{it}</li>)}
        </ul>
        <div class="addon__acts">
          <button class="btn btn--light btn--lg" type="button" data-lead data-plano={addon.nome}><Brand name="whatsapp" size={19} /> Quero o módulo de licitações</button>
          <a class="link-arrow" href="/licitacoes/">Ver tudo o que o módulo faz <Icon name="arrow" size={16} /></a>
        </div>
      </article>

      <div class="incl reveal">
        <h2 class="incl__title">Todo plano inclui</h2>
        <div class="incl__grid">
          {inclusos.map((x) => (
            <div class="incl__item">
              <div class="incl__ic"><Icon name={x.i} size={20} /></div>
              <div><p class="incl__t">{x.t}</p><p class="incl__d">{x.d}</p></div>
            </div>
          ))}
        </div>
      </div>

      <div class="plans-faq reveal">
        <h2 class="incl__title">Dúvidas sobre os planos</h2>
        <div class="plans-faq__grid">
          {faqPlanos.map((f) => <div class="plans-faq__item"><h3>{f.q}</h3><p>{f.a}</p></div>)}
        </div>
      </div>

      <p class="plans__help reveal">Não sabe qual escolher? <button type="button" class="link-arrow plans__help-btn" data-lead data-origem="Ajuda para escolher plano">Conte sua operação e a gente indica <Icon name="arrow" size={16} /></button></p>
    </div>
  </section>

  <ContactSection origem="Página de planos" uid="planos" waText={waMsg.planos}
    eyebrow="Monte o seu plano" title="Prefere montar um plano sob medida?"
    lead="Diga quantos CNPJs, quantas pessoas e o que você precisa resolver. Respondemos pelo WhatsApp com a proposta." />
</Base>

<style>
  .plans-hero { padding-bottom: clamp(110px, 12vw, 150px); }
  .plans-sec { padding-top: 0; }
  .plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; align-items: stretch; margin-top: clamp(-110px, -9vw, -80px); position: relative; z-index: 2; }
  .plan { position: relative; display: flex; flex-direction: column; background: #fff; border: 1px solid var(--line); border-radius: var(--r-lg); padding: clamp(24px, 3vw, 32px); box-shadow: var(--shadow-lg); }
  .plan--hot { border: 2px solid var(--brand); }
  .plan__flag { position: absolute; top: -14px; left: 50%; transform: translateX(-50%); white-space: nowrap; background: var(--grad-brand); color: #fff; font-size: 12.5px; font-weight: 700; padding: 6px 14px; border-radius: 999px; }
  .plan__name { font-size: 26px; }
  .plan__for { margin-top: 8px; color: var(--ink-soft); font-size: 15px; min-height: 46px; }
  .plan__price { margin-top: 20px; padding: 16px 0; border-block: 1px solid var(--line-soft); }
  .plan__val { font-family: var(--font-display); font-size: 38px; font-weight: 700; letter-spacing: -.03em; color: var(--navy); line-height: 1.1; }
  .plan__val small { font-size: 15px; color: var(--muted); font-weight: 600; margin-left: 4px; letter-spacing: 0; }
  .plan__val--q { font-size: 24px; }
  .plan__note { color: var(--muted); font-size: 13px; margin-top: 4px; }
  .plan__resume { margin-top: 18px; font-weight: 600; color: var(--ink); }
  .plan__list { list-style: none; padding: 0; margin: 16px 0 26px; display: grid; gap: 11px; flex: 1; }
  .plan__list li { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; color: var(--ink-soft); line-height: 1.45; }
  .plan :global(.plan__ck) { color: var(--brand); flex-shrink: 0; margin-top: 3px; }
  .plan__cta { width: 100%; }
  @media (max-width: 980px) { .plans { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; } .plan__for { min-height: 0; } }

  .addon { margin-top: 28px; padding: clamp(24px, 3.5vw, 40px); border-radius: var(--r-lg); background: linear-gradient(150deg, #0b1442, #050a24); color: var(--on-dark); display: grid; grid-template-columns: 1.1fr 1fr; gap: 24px 40px; align-items: center; }
  .addon__head { display: flex; gap: 18px; align-items: flex-start; }
  .addon__ic { flex-shrink: 0; width: 58px; height: 58px; border-radius: 16px; display: grid; place-items: center; background: rgba(110,160,255,.18); color: var(--brand-light); }
  .addon__tag { font-size: 12.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--brand-light); }
  .addon__name { color: #fff; font-size: clamp(22px, 2.4vw, 28px); margin-top: 6px; }
  .addon__for { color: var(--on-dark-soft); margin-top: 8px; }
  .addon__list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px 18px; }
  .addon__list li { display: flex; gap: 9px; align-items: flex-start; color: var(--on-dark-soft); font-size: 15px; }
  .addon :global(.addon__ck) { color: #4ade80; flex-shrink: 0; margin-top: 3px; }
  .addon__acts { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 18px; padding-top: 18px; border-top: 1px solid rgba(255,255,255,.1); }
  .addon .link-arrow { color: var(--brand-light); }
  @media (max-width: 860px) { .addon { grid-template-columns: 1fr; } .addon__list { grid-template-columns: 1fr; } }

  .incl { margin-top: 32px; padding: clamp(24px, 4vw, 40px); border-radius: var(--r-lg); background: linear-gradient(135deg, #f4f8ff, #eaf1ff); border: 1px solid #dbe6fb; }
  .incl__title { font-size: clamp(22px, 2.4vw, 28px); }
  .incl__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; margin-top: 22px; }
  .incl__item { display: flex; gap: 14px; align-items: flex-start; }
  .incl__ic { flex-shrink: 0; width: 46px; height: 46px; border-radius: 12px; display: grid; place-items: center; background: #fff; color: var(--brand); border: 1px solid var(--line); box-shadow: var(--shadow-sm); }
  .incl__t { font-weight: 700; font-size: 15.5px; color: var(--ink); }
  .incl__d { font-size: 14px; color: var(--ink-soft); margin-top: 3px; line-height: 1.5; }
  @media (max-width: 900px) { .incl__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .incl__grid { grid-template-columns: 1fr; } }

  .plans-faq { margin-top: 32px; }
  .plans-faq__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 20px; }
  .plans-faq__item { padding: 22px; border-radius: var(--r-md); background: #fff; border: 1px solid var(--line); }
  .plans-faq__item h3 { font-family: var(--font); font-size: 16.5px; font-weight: 700; letter-spacing: 0; }
  .plans-faq__item p { margin-top: 8px; color: var(--ink-soft); font-size: 15px; }
  @media (max-width: 720px) { .plans-faq__grid { grid-template-columns: 1fr; } }

  .plans__help { text-align: center; margin-top: 32px; color: var(--ink-soft); font-size: 16px; }
  .plans__help-btn { background: none; border: 0; cursor: pointer; font: inherit; font-weight: 600; padding: 0; }
</style>

---
import Base from "../layouts/Base.astro";
import ContactSection from "../components/ContactSection.astro";
import Icon from "../components/Icon.astro";
import Brand from "../components/Brand.astro";
import { planos, recursos } from "../data/planos";
import { waMsg } from "../data/site";
import "../styles/internal.css";

const inclusos = [
  { i: "handshake", t: "Implantação conduzida", d: "Nossa equipe configura, importa seus dados e testa com você." },
  { i: "receipt", t: "Notas fiscais ilimitadas", d: "NF-e e NFS-e sem limite de emissão em todos os planos." },
  { i: "lock", t: "Segurança de verdade", d: "Certificado cifrado, permissões por perfil e auditoria." },
  { i: "layers", t: "Atualizações contínuas", d: "Novas funções entram sem reinstalar nada." },
];
const licRecursos = [
  { i: "search", t: "Busca no PNCP", d: "Editais abertos do Brasil inteiro" },
  { i: "layers", t: "Kanban de licitações", d: "O cartão anda junto com o status" },
  { i: "shield", t: "Certidões com aviso", d: "Nenhuma vence sem você saber" },
  { i: "contract", t: "Saldo de contrato", d: "Faturado, empenhado e o que falta" },
  { i: "landmark", t: "Empenhos automáticos", d: "Faturado e recebido calculados" },
  { i: "upload", t: "AF em PDF vira nota", d: "Até 50 de uma vez" },
  { i: "cart", t: "Compra para o contrato", d: "Conta a pagar ao receber" },
  { i: "chart", t: "Resultado por licitação", d: "O lucro real de cada processo" },
];
const faqPlanos = [
  { q: "Quanto custa a Sebra?", a: "O plano Essencial custa R$ 327 por mês e o Profissional R$ 565 por mês. O Escala começa em R$ 990 por mês e é montado sob consulta, conforme o número de empresas e o volume." },
  { q: "Posso contratar adicionais no meu plano?", a: "Sim, em todos os planos. Se precisar de mais usuários, de boleto em mais bancos ou de mais CNPJs do que o plano inclui, é só contratar o adicional, sem precisar trocar de plano." },
  { q: "Em qual plano está a licitação?", a: "A licitação está incluída nos planos Profissional e Escala. No Essencial, ela pode ser contratada como adicional." },
  { q: "As notas fiscais são limitadas?", a: "Não. NF-e e NFS-e são ilimitadas em todos os planos." },
  { q: "Posso mudar de plano depois?", a: "Sim. Você começa pelo plano que faz sentido hoje e sobe quando a empresa crescer, sem trocar de sistema." },
  { q: "A implantação está incluída?", a: "A implantação é conduzida pela nossa equipe: configuramos, importamos seus dados e testamos com você antes de liberar." },
  { q: "Vocês também fazem automações?", a: "Sim. Além do sistema, desenvolvemos automações operacionais sob medida para os processos da sua empresa. O valor é definido depois do diagnóstico." },
];
---
<Base
  product
  title="Planos e preços do sistema de licitação e ERP | Sebra"
  description="Planos Essencial (R$ 327/mês), Profissional (R$ 565/mês) e Escala. Licitação a partir do Profissional, notas fiscais ilimitadas e financeiro com baixa pelo extrato."
  crumbs={[{ name: "Planos", href: "/planos/" }]}
  faq={faqPlanos}
  waText={waMsg.planos}
>
  <section class="ip-hero showcase plans-hero">
    <div class="container">
      <div class="s-head s-head--center" style="margin-inline:auto">
        <p class="ip-crumbs ip-crumbs--dark" style="text-align:center"><a href="/">Início</a> · Planos</p>
        <p class="eyebrow">Planos</p>
        <h1>Licitação, nota e financeiro. Escolha o tamanho.</h1>
        <p class="ip-hero__lead" style="margin-inline:auto">Notas fiscais ilimitadas em todos os planos e licitação a partir do Profissional. Escolha, preencha uma vez e fale com a gente no WhatsApp com tudo explicado.</p>
      </div>
    </div>
  </section>

  <section class="section plans-sec">
    <div class="container">
      <div class="plans">
        {planos.map((p, i) => (
          <article class={`plan reveal${p.destaque ? " plan--hot" : ""}`} data-delay={i}>
            {p.destaque && <p class="plan__flag">Mais escolhido para crescer</p>}
            <h2 class="plan__name">{p.nome}</h2>
            <p class="plan__for">{p.publico}</p>
            <div class="plan__price">
              {p.preco ? (
                <>
                  {p.preco.prefixo && <p class="plan__pre">{p.preco.prefixo}</p>}
                  <p class="plan__val">{p.preco.valor}{p.preco.periodo && <small>{p.preco.periodo}</small>}</p>
                  {p.preco.nota && <p class="plan__note">{p.preco.nota}</p>}
                  <p class="plan__extra"><span class="plus" aria-hidden="true">+</span>Adicionais disponíveis quando precisar</p>
                </>
              ) : (
                <><p class="plan__val plan__val--q">Valor sob consulta</p></>
              )}
            </div>
            <p class="plan__resume">{p.resumo}</p>
            <ul class="plan__list">
              {p.itens.map((it) => <li><Icon name="check" size={16} stroke={2.6} class="plan__ck" />{it}</li>)}
            </ul>
            <button class={`btn ${p.destaque ? "btn--wa" : "btn--primary"} btn--lg plan__cta`} type="button" data-lead data-plano={p.nome}>
              <Brand name="whatsapp" size={19} /> {p.cta}
            </button>
          </article>
        ))}
      </div>

      <div class="cmp reveal">
        <h2 class="cmp__title">Compare os planos</h2>
        <div class="cmp__wrap">
          <table class="cmp__tbl">
            <caption class="sr-only">Comparativo dos planos Essencial, Profissional e Escala</caption>
            <thead>
              <tr>
                <th scope="col"><span class="sr-only">Recurso</span></th>
                {planos.map((p) => <th scope="col" class={p.destaque ? "is-hot" : ""}>{p.nome}</th>)}
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Preço</th>
                {planos.map((p) => <td class={p.destaque ? "is-hot" : ""}><strong>{p.preco ? `${p.preco.prefixo ? p.preco.prefixo + " " : ""}${p.preco.valor}${p.preco.periodo ?? ""}` : "Sob consulta"}</strong>{p.preco?.nota && <span class="cmp__sub">{p.preco.nota}</span>}</td>)}
              </tr>
              <tr>
                <th scope="row">Para quem</th>
                {planos.map((p) => <td class={p.destaque ? "is-hot" : ""}>{p.publico.replace(/^Para /, "").replace(/\.$/, "").replace(/^./, (c) => c.toUpperCase())}</td>)}
              </tr>
              {recursos.map((r) => (
                <tr>
                  <th scope="row">{r.nome}{r.ampliavel && <span class="plus plus--row" title="Pode ser ampliado com adicionais" aria-label="pode ser ampliado com adicionais">+</span>}</th>
                  {r.valores.map((v, i) => (
                    <td class={planos[i].destaque ? "is-hot" : ""}>
                      {v === true ? <span class="cmp__yes" aria-label="Incluído"><Icon name="check" size={17} stroke={2.8} /></span>
                        : v === false ? <span class="cmp__no" aria-label="Não incluído">–</span>
                        : v === "Adicional" ? <span class="cmp__add">Adicional</span>
                        : <span class={v === "Ilimitadas" ? "cmp__strong" : ""}>{v}</span>}
                    </td>
                  ))}
                </tr>
              ))}
              <tr class="cmp__cta">
                <th scope="row"><span class="sr-only">Escolher</span></th>
                {planos.map((p) => <td class={p.destaque ? "is-hot" : ""}><button class={`btn ${p.destaque ? "btn--wa" : "btn--ghost"} btn--sm`} type="button" data-lead data-plano={p.nome}>{p.cta}</button></td>)}
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <p class="cmp__note reveal"><span class="plus" aria-hidden="true">+</span> Pode ser ampliado com <strong>adicionais</strong> em todos os planos, sem trocar de plano.</p>

      <section class="lic reveal" aria-labelledby="lic-t">
        <div class="lic__top">
          <div class="lic__intro">
            <p class="lic__badge"><Icon name="gavel" size={14} /> Especialidade Sebra</p>
            <h2 class="lic__t" id="lic-t">Licitações e Contratos Públicos</h2>
            <p class="lic__lead">Do edital ao dinheiro na conta, num módulo feito para quem vende ao governo e ligado às notas, ao estoque e ao financeiro.</p>
          </div>
          <ul class="lic__plans" aria-label="Disponibilidade por plano">
            <li><span class="lic__pn">Essencial</span><span class="lic__pv lic__pv--add">Adicional</span></li>
            <li><span class="lic__pn">Profissional</span><span class="lic__pv lic__pv--ok"><Icon name="check" size={14} stroke={3} /> Incluso</span></li>
            <li><span class="lic__pn">Escala</span><span class="lic__pv lic__pv--ok"><Icon name="check" size={14} stroke={3} /> Incluso</span></li>
          </ul>
        </div>
        <div class="lic__grid">
          {licRecursos.map((r) => (
            <div class="lic__item">
              <div class="lic__ic"><Icon name={r.i} size={19} /></div>
              <div><p class="lic__it">{r.t}</p><p class="lic__id">{r.d}</p></div>
            </div>
          ))}
        </div>
        <div class="lic__acts">
          <button class="btn btn--primary btn--lg" type="button" data-lead data-plano="Adicional de licitações"><Brand name="whatsapp" size={19} /> Quero licitações na Sebra</button>
          <a class="lic__more" href="/licitacoes/">Ver tudo sobre o módulo <Icon name="arrow" size={16} /></a>
        </div>
      </section>

      <div class="ai reveal">
        <div class="ai__copy">
          <p class="ai__k"><Icon name="zap" size={14} /> Automação de processos</p>
          <p class="ai__t">Além do sistema, <span class="ai__grad">automatizamos</span> a sua operação.</p>
          <p class="ai__d">Robôs, integrações e fluxos sob medida para os processos que tomam o tempo da sua equipe.</p>
          <a class="ai__btn" href="/automacoes/">Conhecer as automações <Icon name="arrow" size={16} /></a>
        </div>
        <div class="ai__flow" aria-hidden="true">
          <div class="ai__node"><Icon name="mail" size={16} /><span>Gatilho</span></div>
          <div class="ai__line"><i></i></div>
          <div class="ai__node ai__node--mid"><Icon name="bot" size={16} /><span>Processo</span></div>
          <div class="ai__line"><i></i></div>
          <div class="ai__node ai__node--end"><Icon name="checkCircle" size={16} /><span>Resultado</span></div>
        </div>
      </div>

      <div class="incl reveal">
        <h2 class="incl__title">Todo plano inclui</h2>
        <div class="incl__grid">
          {inclusos.map((x) => (
            <div class="incl__item">
              <div class="incl__ic"><Icon name={x.i} size={20} /></div>
              <div><p class="incl__t">{x.t}</p><p class="incl__d">{x.d}</p></div>
            </div>
          ))}
        </div>
      </div>

      <div class="plans-faq reveal">
        <h2 class="incl__title">Dúvidas sobre os planos</h2>
        <div class="plans-faq__grid">
          {faqPlanos.map((f) => <div class="plans-faq__item"><h3>{f.q}</h3><p>{f.a}</p></div>)}
        </div>
      </div>
    </div>
  </section>

  <ContactSection origem="Página de planos" uid="planos" waText={waMsg.planos}
    eyebrow="Fale com a gente" title="Ficou com dúvida sobre qual plano escolher?"
    lead="Conte quantos CNPJs, quantas pessoas e como você vende hoje. Respondemos pelo WhatsApp indicando o plano certo." />
</Base>

<style>
  .plans-hero { padding-bottom: clamp(110px, 12vw, 150px); }
  .plans-sec { padding-top: 0; }
  .plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; align-items: stretch; margin-top: clamp(-110px, -9vw, -80px); position: relative; z-index: 2; }
  .plan { position: relative; display: flex; flex-direction: column; background: #fff; border: 1px solid var(--line); border-radius: var(--r-lg); padding: clamp(24px, 3vw, 32px); box-shadow: var(--shadow-lg); }
  .plan--hot { border: 2px solid var(--brand); }
  .plan__flag { position: absolute; top: -14px; left: 50%; transform: translateX(-50%); white-space: nowrap; background: var(--grad-brand); color: #fff; font-size: 12.5px; font-weight: 700; padding: 6px 14px; border-radius: 999px; }
  .plan__name { font-size: 26px; }
  .plan__for { margin-top: 8px; color: var(--ink-soft); font-size: 15px; min-height: 46px; }
  .plan__price { margin-top: 20px; padding: 16px 0; border-block: 1px solid var(--line-soft); min-height: 104px; }
  .plan__pre { color: var(--muted); font-size: 13.5px; font-weight: 600; }
  .plan__val { font-family: var(--font-display); font-size: 40px; font-weight: 700; letter-spacing: -.03em; color: var(--navy); line-height: 1.1; }
  .plan__val small { font-size: 15px; color: var(--muted); font-weight: 600; margin-left: 4px; letter-spacing: 0; }
  .plan__val--q { font-size: 24px; }
  .plan__note { color: var(--muted); font-size: 13px; margin-top: 2px; }
  .plan__extra { display: flex; align-items: center; gap: 7px; margin-top: 8px; font-size: 13px; font-weight: 600; color: var(--brand); }
  .plus { flex-shrink: 0; display: inline-grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; background: #e3edff; color: var(--brand); font-family: var(--font); font-size: 13px; font-weight: 800; line-height: 1; }
  .plus--row { margin-left: 8px; vertical-align: 1px; cursor: help; }
  .cmp__note { display: flex; gap: 10px; align-items: center; justify-content: center; flex-wrap: wrap; margin-top: 16px; text-align: center; color: var(--ink-soft); font-size: 15px; }
  .cmp__note :global(svg) { color: var(--brand); }
  .cmp__note strong { color: var(--ink); }
  .plan__resume { margin-top: 18px; font-weight: 600; color: var(--ink); }
  .plan__list { list-style: none; padding: 0; margin: 16px 0 26px; display: grid; gap: 11px; flex: 1; align-content: start; }
  .plan__list li { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; color: var(--ink-soft); line-height: 1.45; }
  .plan :global(.plan__ck) { color: var(--brand); flex-shrink: 0; margin-top: 3px; }
  .plan__cta { width: 100%; }
  @media (max-width: 980px) { .plans { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; } .plan__for, .plan__price { min-height: 0; } }

  .cmp { margin-top: 48px; }
  .cmp__title { font-size: clamp(24px, 2.6vw, 32px); text-align: center; }
  .cmp__wrap { margin-top: 24px; overflow-x: auto; border: 1px solid var(--line); border-radius: var(--r-lg); background: #fff; box-shadow: var(--shadow); }
  .cmp__tbl { width: 100%; min-width: 720px; border-collapse: collapse; }
  .cmp__tbl th, .cmp__tbl td { padding: 15px 18px; border-bottom: 1px solid var(--line-soft); text-align: left; vertical-align: middle; font-size: 15px; }
  .cmp__tbl thead th { font-family: var(--font-display); font-size: 17px; color: var(--ink); background: #fafcff; }
  .cmp__tbl tbody th { font-weight: 600; color: var(--ink); width: 34%; }
  .cmp__tbl td { color: var(--ink-soft); width: 22%; }
  .cmp__tbl .is-hot { background: #f3f7ff; }
  .cmp__tbl thead .is-hot { background: var(--navy); color: #fff; }
  .cmp__sub { display: block; font-size: 13px; color: var(--muted); }
  .cmp__yes { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: #e3f6ec; color: var(--ok); }
  .cmp__no { color: #a8b2c2; font-size: 20px; }
  .cmp__strong { font-weight: 700; color: var(--ink); }
  .cmp__add { display: inline-block; padding: 4px 10px; border-radius: 999px; background: #fff4e0; border: 1px solid #f5d08a; color: #8a4b00; font-size: 13px; font-weight: 700; }
  .cmp__cta td, .cmp__cta th { border-bottom: 0; }

  .lic { position: relative; overflow: hidden; margin-top: 32px; padding: clamp(24px, 3.5vw, 40px); border-radius: 20px; border: 1.5px solid transparent;
    background:
      radial-gradient(520px 260px at 100% 0%, rgba(251,191,36,.20), transparent 70%) padding-box,
      linear-gradient(160deg, #fffaf0 0%, #ffffff 55%) padding-box,
      linear-gradient(135deg, #f5c26b, #d97706 45%, #f5c26b) border-box;
    box-shadow: 0 24px 60px -24px rgba(180,83,9,.30); }
  .lic::after { content: ""; position: absolute; right: -40px; top: -40px; width: 220px; height: 220px; border-radius: 50%; border: 28px solid rgba(217,119,6,.06); pointer-events: none; }
  .lic__top { position: relative; z-index: 1; display: grid; grid-template-columns: 1.4fr 1fr; gap: 28px; align-items: center; }
  .lic__badge { display: inline-flex; align-items: center; gap: 6px; padding: 5px 11px; border-radius: 999px; background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .lic__t { font-size: clamp(26px, 3vw, 36px); margin-top: 12px; color: var(--ink); }
  .lic__lead { margin-top: 10px; color: var(--ink-soft); font-size: 16.5px; max-width: 560px; }
  .lic__plans { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .lic__plans li { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; border-radius: 12px; background: #fff; border: 1px solid #f3e1bd; }
  .lic__pn { font-weight: 700; color: var(--ink); font-size: 15px; }
  .lic__pv { display: inline-flex; align-items: center; gap: 5px; padding: 4px 11px; border-radius: 999px; font-size: 13px; font-weight: 700; }
  .lic__pv--add { background: #fff4e0; color: #8a4b00; border: 1px solid #f5d08a; }
  .lic__pv--ok { background: #e3f6ec; color: var(--ok); }
  .lic__grid { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 28px; }
  .lic__item { display: flex; gap: 12px; align-items: flex-start; padding: 16px; border-radius: 14px; background: rgba(255,255,255,.85); border: 1px solid #f3e6cc; transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
  .lic__item:hover { transform: translateY(-2px); border-color: #f5c26b; box-shadow: 0 10px 24px -12px rgba(180,83,9,.35); }
  .lic__ic { flex-shrink: 0; width: 40px; height: 40px; border-radius: 11px; display: grid; place-items: center; background: linear-gradient(135deg, #fef3c7, #fde68a); color: #b45309; }
  .lic__it { font-weight: 700; color: var(--ink); font-size: 15px; }
  .lic__id { color: var(--muted); font-size: 13.5px; margin-top: 2px; line-height: 1.4; }
  .lic__acts { position: relative; z-index: 1; display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: 26px; padding-top: 22px; border-top: 1px solid #f3e1bd; }
  .lic__more { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; color: #b45309; }
  .lic__more :global(svg) { transition: transform .2s ease; }
  .lic__more:hover :global(svg) { transform: translateX(4px); }
  @media (max-width: 980px) { .lic__top { grid-template-columns: 1fr; } .lic__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .lic__grid { grid-template-columns: 1fr; } }
  .ai { position: relative; overflow: hidden; margin-top: 20px; display: grid; grid-template-columns: 1.1fr 1fr; gap: 28px; align-items: center; padding: clamp(24px, 3.5vw, 36px); border-radius: 18px; border: 1px solid transparent;
    background:
      radial-gradient(420px 220px at 85% 0%, rgba(34,211,238,.18), transparent 70%) padding-box,
      radial-gradient(380px 240px at 0% 100%, rgba(59,130,246,.22), transparent 70%) padding-box,
      radial-gradient(rgba(255,255,255,.07) 1px, transparent 1px) 0 0 / 20px 20px padding-box,
      linear-gradient(#060b22, #060b22) padding-box,
      linear-gradient(120deg, #3b82f6, #22d3ee 50%, #3b82f6) border-box; }
  .ai__k { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #67e8f9; }
  .ai__t { font-family: var(--font-display); font-weight: 700; font-size: clamp(20px, 2.2vw, 26px); color: #fff; line-height: 1.25; margin-top: 8px; }
  .ai__grad { background: linear-gradient(90deg, #60a5fa, #22d3ee); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .ai__d { color: #9fb0d0; font-size: 14.5px; margin-top: 8px; max-width: 460px; }
  .ai__btn { display: inline-flex; align-items: center; gap: 7px; margin-top: 16px; padding: 10px 16px; border-radius: 10px; font-weight: 600; font-size: 14px; color: #fff; background: rgba(255,255,255,.06); border: 1px solid rgba(103,232,249,.35); transition: background .2s ease, border-color .2s ease; }
  .ai__btn:hover { background: rgba(34,211,238,.12); border-color: #22d3ee; }
  .ai__flow { display: flex; align-items: center; justify-content: center; }
  .ai__node { flex-shrink: 0; display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 12px 14px; min-width: 92px; border-radius: 12px; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.12); color: #cbd5e1; font-size: 12.5px; font-weight: 600; }
  .ai__node :global(svg) { color: #60a5fa; }
  .ai__node--mid { border-color: rgba(34,211,238,.45); box-shadow: 0 0 24px rgba(34,211,238,.18); }
  .ai__node--mid :global(svg) { color: #22d3ee; }
  .ai__node--end :global(svg) { color: #4ade80; }
  .ai__line { position: relative; flex: 1; min-width: 26px; height: 2px; background: linear-gradient(90deg, rgba(96,165,250,.25), rgba(34,211,238,.45)); }
  .ai__line i { position: absolute; top: 50%; left: 0; width: 7px; height: 7px; margin-top: -3.5px; border-radius: 50%; background: #67e8f9; box-shadow: 0 0 10px #22d3ee; animation: aiFlow 2.4s linear infinite; }
  .ai__line + .ai__node + .ai__line i { animation-delay: 1.2s; }
  @keyframes aiFlow { from { left: 0; opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } to { left: calc(100% - 7px); opacity: 0; } }

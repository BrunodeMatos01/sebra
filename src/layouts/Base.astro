---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LeadForm from "../components/LeadForm.astro";
import Brand from "../components/Brand.astro";
import CookieBanner from "../components/CookieBanner.astro";
import { site, waLink, waMsg } from "../data/site";
import { planos } from "../data/planos";
// Fontes servidas pelo próprio site (sem Google Fonts): menos terceiros, mais privacidade e velocidade.
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/inter/latin-700.css";
import "@fontsource/sora/latin-600.css";
import "@fontsource/sora/latin-700.css";
import "@fontsource/sora/latin-800.css";
import "../styles/sebra.css";
// Pré-carrega as duas fontes que aparecem na primeira dobra (melhora o LCP).
import interRegular from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import soraHeavy from "@fontsource/sora/files/sora-latin-800-normal.woff2?url";

export interface Props {
  title?: string;
  description?: string;
  image?: string;                 // caminho da imagem de compartilhamento
  crumbs?: { name: string; href: string }[]; // para o BreadcrumbList do Google
  faq?: { q: string; a: string }[];          // para o FAQPage do Google
  waText?: string;                // mensagem do botão flutuante nesta página
  noindex?: boolean;
  product?: boolean;              // inclui o SoftwareApplication com preços (home e planos)
  type?: "website" | "article";
  article?: { published: string; modified?: string; author?: string };
  extraLd?: object[];             // blocos extras de dados estruturados
}
const {
  title = "Sebra ERP com IA | Sistema de licitação, ERP e automação empresarial",
  description = "Sistema de licitação e ERP com notas fiscais, orçamentos, estoque e financeiro, mais automação de processos sob medida para a sua empresa.",
  image = "/img/og-image.png",
  crumbs = [],
  faq = [],
  waText = waMsg.geral,
  noindex = false,
  product = false,
  type = "website",
  article,
  extraLd = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;

const org = {
  "@type": "Organization",
  "@id": `${site.url}/#org`,
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  logo: `${site.url}/img/icon-512.png`,
  email: site.email,
  sameAs: [site.instagram],
  ...(site.cnpj ? { taxID: site.cnpj } : {}),
  address: { "@type": "PostalAddress", addressRegion: site.city, addressCountry: "BR" },
  contactPoint: [{
    "@type": "ContactPoint", contactType: "sales", telephone: `+${site.whatsapp}`,
    availableLanguage: ["Portuguese"], areaServed: "BR",
  }],
};
const offers = planos.filter((p) => p.preco).map((p) => ({
  "@type": "Offer", name: `Plano ${p.nome}`, url: `${site.url}/planos/`, priceCurrency: "BRL",
  price: p.preco!.valor.replace(/[^0-9,]/g, "").replace(",", "."),
  priceSpecification: { "@type": "UnitPriceSpecification", price: p.preco!.valor.replace(/[^0-9,]/g, "").replace(",", "."), priceCurrency: "BRL", unitText: "MONTH" },
}));
const graph: object[] = [
  org,
  { "@type": "WebSite", "@id": `${site.url}/#site`, url: site.url, name: "Sebra", inLanguage: "pt-BR", publisher: { "@id": `${site.url}/#org` } },
];
if (product) graph.push(
  {
    "@type": "SoftwareApplication",
    name: "Sebra",
    applicationCategory: "BusinessApplication",
    applicationSubCategory: "Sistema de licitação, ERP e automação empresarial",
    operatingSystem: "Web",
    url: site.url,
    inLanguage: "pt-BR",
    description,
    publisher: { "@id": `${site.url}/#org` },
    ...(offers.length ? { offers } : {}),
    featureList: [
      "Busca de editais no PNCP", "Gestão de licitações e habilitação", "Quadro Kanban de licitações", "Automação de processos sob medida", "Controle de certidões negativas",
      "Contratos públicos com saldo e vigência", "Controle de empenhos", "NF-e, NFS-e e NFC-e com retenções",
      "Boleto registrado com baixa automática", "Conciliação bancária automática", "Resultado por licitação",
      "Financeiro completo, DRE e fluxo de caixa", "Estoque, compras e orçamentos", "Multi-empresa",
    ],
  },
);
graph.push({
  "@type": type === "article" ? "Article" : "WebPage",
  "@id": `${canonical}#page`,
  url: canonical,
  name: title,
  description,
  inLanguage: "pt-BR",
  isPartOf: { "@id": `${site.url}/#site` },
  primaryImageOfPage: ogImage,
  ...(type === "article" && article ? {
    headline: title.replace(/ [|] Sebra.*$/, ""),
    image: ogImage,
    datePublished: article.published,
    dateModified: article.modified || article.published,
    author: { "@type": "Organization", name: article.author || "Equipe Sebra", url: `${site.url}/empresa/` },
    publisher: { "@id": `${site.url}/#org` },
    mainEntityOfPage: canonical,
  } : {}),
});
graph.push(...extraLd);
if (crumbs.length) graph.push({
  "@type": "BreadcrumbList",
  itemListElement: [{ name: "Início", href: "/" }, ...crumbs].map((c, i) => ({
    "@type": "ListItem", position: i + 1, name: c.name, item: new URL(c.href, site.url).href,
  })),
});
if (faq.length) graph.push({
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
});
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang="pt-BR" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <meta name="author" content="Sebra" />
    <meta name="theme-color" content="#04102e" />
    <meta name="format-detection" content="telephone=no" />
    {site.googleVerification && <meta name="google-site-verification" content={site.googleVerification} />}
    {site.bingVerification && <meta name="msvalidate.01" content={site.bingVerification} />}

    <meta property="og:type" content={type} />
    {article && <meta property="article:published_time" content={article.published} />}
    {article && <meta property="article:modified_time" content={article.modified || article.published} />}
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Sebra" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/img/icon-192.png" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="Guias Sebra" href="/guias/rss.xml" />
    <link rel="preload" href={interRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={soraHeavy} as="font" type="font/woff2" crossorigin />


    <script is:inline>document.documentElement.classList.remove("no-js");</script>

    <!-- Google Analytics 4 -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.gaId}`}></script>
    <!-- Consent Mode v2 (LGPD): tudo começa negado; só libera cookies se a pessoa aceitar no aviso. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      var c = null; try { c = localStorage.getItem("sebra_consent"); } catch (e) {}
      var ok = c === "granted" ? "granted" : "denied";
      gtag("consent", "default", { analytics_storage: ok, ad_storage: ok, ad_user_data: ok, ad_personalization: ok, functionality_storage: "granted", security_storage: "granted", wait_for_update: 500 });
      gtag("set", "url_passthrough", true);
      gtag("set", "ads_data_redaction", ok !== "granted");
      gtag("js", new Date());
      gtag("config", "G-JTFWMLLGE3", { anonymize_ip: true });
    </script>

    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </head>

  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />

    <!-- Botões flutuantes: WhatsApp (principal) e Instagram -->
    <div class="float-social">
      <a class="float-social__ig" href={site.instagram} target="_blank" rel="noopener" aria-label={`Instagram da Sebra (${site.instagramHandle})`} data-track="instagram_click">
        <Brand name="instagram" size={22} />
      </a>
      <a class="float-social__wa" href={waLink(waText)} target="_blank" rel="noopener" aria-label="Falar com a Sebra no WhatsApp" data-track="whatsapp_click">
        <Brand name="whatsapp" size={30} />
        <span class="float-social__label">Fale com a gente</span>
      </a>
    </div>

    <!-- Modal de contato: qualquer elemento com [data-lead] abre.
         data-plano="Gestão Pública" pré-seleciona o plano. -->
    <CookieBanner />

    <dialog class="lead-modal" id="lead-modal" aria-labelledby="lead-modal-title">
      <div class="lead-modal__box">
        <button class="lead-modal__close" type="button" data-close aria-label="Fechar">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
        <p class="eyebrow">Atendimento pelo WhatsApp</p>
        <h2 id="lead-modal-title" class="lead-modal__title">Conte rapidinho sobre a sua empresa</h2>
        <p class="lead-modal__lead" data-modal-lead>Você preenche uma vez e já abrimos o WhatsApp com tudo escrito. Ninguém vai te pedir a mesma informação de novo.</p>
        <LeadForm uid="modal" origem="Modal do site" />
      </div>
    </dialog>

    <script>
      // Header: sombra ao rolar
      const header = document.querySelector("[data-header]");
      const onScroll = () => header?.classList.toggle("is-scrolled", window.scrollY > 8);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      // Menu mobile
      const burger = document.querySelector("[data-burger]");
      const mobile = document.querySelector("[data-mobile]");
      burger?.addEventListener("click", () => {
        const open = mobile?.classList.toggle("is-open");
        mobile?.toggleAttribute("hidden", !open);
        burger.setAttribute("aria-expanded", String(!!open));
        document.body.style.overflow = open ? "hidden" : "";
      });
      mobile?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => {
        mobile.classList.remove("is-open"); mobile.setAttribute("hidden", "");
        burger?.setAttribute("aria-expanded", "false"); document.body.style.overflow = "";
      }));

      // Dropdown por clique (além do hover)
      document.querySelectorAll("[data-dropdown]").forEach((group) => {
        const btn = group.querySelector("button");
        btn?.addEventListener("click", (e) => {
          e.preventDefault();
          const expanded = btn.getAttribute("aria-expanded") === "true";
          document.querySelectorAll("[data-dropdown] button").forEach((b) => b.setAttribute("aria-expanded", "false"));
          btn.setAttribute("aria-expanded", String(!expanded));
        });
      });
      document.addEventListener("click", (e) => {
        if (!(e.target as HTMLElement).closest("[data-dropdown]"))
          document.querySelectorAll("[data-dropdown] button").forEach((b) => b.setAttribute("aria-expanded", "false"));
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") document.querySelectorAll("[data-dropdown] button").forEach((b) => b.setAttribute("aria-expanded", "false"));
      });

      // Reveal on scroll
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) { entry.target.classList.add("is-in"); io.unobserve(entry.target); }
        });
      }, { threshold: 0.1, rootMargin: "0px 0px -40px 0px" });
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

      // FAQ acordeão (acessível)
      document.querySelectorAll<HTMLButtonElement>("[data-faq] .faq__q").forEach((q) => {
        q.addEventListener("click", () => {
          const item = q.parentElement!;
          const open = item.classList.contains("is-open");
          item.parentElement!.querySelectorAll(".faq__item.is-open").forEach((i) => {
            i.classList.remove("is-open"); i.querySelector(".faq__q")?.setAttribute("aria-expanded", "false");
          });
          if (!open) { item.classList.add("is-open"); q.setAttribute("aria-expanded", "true"); }
        });
      });

      // Modal de contato
      const modal = document.getElementById("lead-modal") as HTMLDialogElement | null;
      document.addEventListener("click", (e) => {
        const trigger = (e.target as HTMLElement).closest<HTMLElement>("[data-lead]");
        if (!trigger || !modal) return;
        e.preventDefault();
        const plano = trigger.dataset.plano || "";
        const select = modal.querySelector<HTMLSelectElement>('select[name="plano"]');
        if (select) select.value = plano;
        const form = modal.querySelector<HTMLFormElement>("[data-leadform]");
        if (form) form.dataset.origem = trigger.dataset.origem || (plano ? `Botão do plano ${plano}` : location.pathname);
        const lead = modal.querySelector("[data-modal-lead]");
        if (lead) lead.textContent = plano
          ? `Você escolheu o plano ${plano}. Preencha uma vez e abrimos o WhatsApp com tudo escrito.`
          : "Você preenche uma vez e já abrimos o WhatsApp com tudo escrito. Ninguém vai te pedir a mesma informação de novo.";
        window.gtag?.("event", "lead_modal_open", { plano: plano || "indefinido" });
        modal.showModal();
        setTimeout(() => modal.querySelector<HTMLInputElement>('input[name="nome"]')?.focus(), 60);
      });
      modal?.addEventListener("click", (e) => {
        if (e.target === modal || (e.target as HTMLElement).closest("[data-close]")) modal.close();
      });

      // Eventos de clique para o Google Analytics (WhatsApp / Instagram)
      document.addEventListener("click", (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>("a[href*='wa.me'], a[href*='instagram.com']");
        if (!a) return;
        const ev = a.href.includes("wa.me") ? "whatsapp_click" : "instagram_click";
        window.gtag?.("event", ev, { link_text: a.textContent?.trim().slice(0, 60), page: location.pathname });
      });

      declare global { interface Window { gtag?: (...a: unknown[]) => void } }
    </script>

    <style>
      .float-social { position: fixed; right: 20px; bottom: 20px; z-index: 70; display: flex; flex-direction: column; align-items: flex-end; gap: 12px; }
      .float-social a { display: grid; place-items: center; border-radius: 999px; transition: transform .18s ease, box-shadow .18s ease; }
      .float-social__ig { width: 48px; height: 48px; color: #fff; background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fd5949 45%, #d6249f 60%, #285aeb 90%); box-shadow: 0 8px 22px rgba(214,36,159,.35); }
      .float-social__wa { height: 60px; min-width: 60px; padding: 0 15px; display: flex !important; gap: 10px; background: var(--wa); color: #fff; box-shadow: 0 12px 30px rgba(37,211,102,.45); }
      .float-social__label { display: none; font-weight: 700; font-size: 15px; color: var(--wa-ink); white-space: nowrap; }
      .float-social__wa svg { color: #fff; }
      .float-social a:hover { transform: translateY(-3px) scale(1.04); }
      .float-social__wa::after { content: ""; position: absolute; inset: 0; border-radius: inherit; box-shadow: 0 0 0 0 rgba(37,211,102,.55); animation: waPulse 2.6s infinite; pointer-events: none; }
      .float-social__wa { position: relative; }
      @keyframes waPulse { 0% { box-shadow: 0 0 0 0 rgba(37,211,102,.5); } 70% { box-shadow: 0 0 0 16px rgba(37,211,102,0); } 100% { box-shadow: 0 0 0 0 rgba(37,211,102,0); } }
      @media (min-width: 1100px) { .float-social__label { display: inline; } .float-social__wa { padding: 0 20px 0 16px; } }
      @media (max-width: 620px) { .float-social { right: 14px; bottom: 14px; } .float-social__ig { width: 44px; height: 44px; } }
      @media (prefers-reduced-motion: reduce) { .float-social__wa::after { animation: none; } }

      .lead-modal { border: 0; padding: 0; background: transparent; max-width: min(640px, calc(100vw - 24px)); width: 100%; max-height: calc(100dvh - 24px); }
      .lead-modal::backdrop { background: rgba(4,16,46,.62); backdrop-filter: blur(4px); }
      .lead-modal__box { position: relative; background: #fff; border-radius: var(--r-lg); padding: clamp(22px, 4vw, 34px); box-shadow: var(--shadow-lg); overflow-y: auto; max-height: calc(100dvh - 24px); }
      .lead-modal__title { font-size: clamp(22px, 3vw, 28px); margin-top: -4px; padding-right: 36px; }
      .lead-modal__lead { color: var(--ink-soft); margin: 10px 0 22px; font-size: 15.5px; }
      .lead-modal__close { position: absolute; top: 14px; right: 14px; width: 40px; height: 40px; border-radius: 10px; border: 1px solid var(--line); background: #fff; cursor: pointer; display: grid; place-items: center; color: var(--ink-soft); }
      .lead-modal__close:hover { color: var(--ink); border-color: var(--line-strong); }
      .lead-modal[open] .lead-modal__box { animation: modalIn .28s cubic-bezier(.16,1,.3,1); }
      @keyframes modalIn { from { opacity: 0; transform: translateY(14px) scale(.98); } to { opacity: 1; transform: none; } }
    </style>
  </body>
</html>
